---
/**
 * 文章过时提醒卡片（orchid-blog showLastModified 卡片移植）。
 * 构建期输出 hidden 卡片 + data-*（日期/阈值/天数文案模板）；
 * 天数由客户端计算（静态站构建期计算会随访问时间失效），超过阈值才显示。
 * enabled 单点裁决（与 License.astro 模式一致）。
 */
import config from "virtual:theme/config";
import { t } from "../i18n/index.js";
import { formatDate } from "../utils.js";

interface Props {
	/** 最后更新时间（调用方传 updated ?? published） */
	updated: Date;
	published: Date;
}

const { updated, published } = Astro.props;
const o = config.outdated;
---

{
  o.enabled && (
    <div class="outdated-card" id="outdated-card" hidden data-date={updated.toISOString()} data-threshold={o.threshold}>
      <div class="outdated-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path></svg>
      </div>
      <div class="outdated-text">
        <p class="outdated-line">
          {t('lastModifiedPrefix')}{formatDate(updated)}
          <span class="outdated-days" data-template={t('lastModifiedDaysAgo')}></span>
        </p>
        <p class="outdated-warning" hidden>{t('lastModifiedOutdated')}</p>
      </div>
    </div>
  )
}

<script is:inline data-astro-rerun>
  (function () {
    const card = document.getElementById("outdated-card");
    if (!card) return;
    const days = Math.floor((Date.now() - new Date(card.dataset.date).getTime()) / 86400000);
    if (days < Number(card.dataset.threshold)) return;
    card.hidden = false;
    if (days >= 1) {
      const el = card.querySelector(".outdated-days");
      if (el) el.textContent = (el.dataset.template || "").replace("{days}", String(days));
    }
    const warn = card.querySelector(".outdated-warning");
    if (warn) warn.hidden = false;
  })();
</script>
