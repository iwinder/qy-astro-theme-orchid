---
import { t } from "../i18n/index.js";

interface Props {
	/** 当前页（从 1 开始） */
	page: number;
	/** 总页数 */
	total: number;
	/** 列表基路径，如 '/'、'/tags/xx/'（带尾斜杠） */
	basePath: string;
}

const { page, total, basePath } = Astro.props;
const hrefFor = (p: number) =>
	p === 1 ? basePath : `${basePath.replace(/\/$/, "")}/page/${p}/`;
---

<nav class="pagination reveal" aria-label={t('pagination')}>
  {
    page > 1 ? (
      <a class="page-item" href={hrefFor(page - 1)}>
        {t('prevPage')}
      </a>
    ) : (
      <span class="page-item disabled">{t('prevPage')}</span>
    )
  }
  <span>{t('pageOf', { current: page, total })}</span>
  {
    page < total ? (
      <a class="page-item" href={hrefFor(page + 1)}>
        {t('nextPage')}
      </a>
    ) : (
      <span class="page-item disabled">{t('nextPage')}</span>
    )
  }
</nav>
