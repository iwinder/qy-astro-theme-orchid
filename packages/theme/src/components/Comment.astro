---
/**
 * 评论适配层：按 config.comment.provider 分发到具体实现（五套可切换）。
 * 站点可经 override 覆盖本组件整体替换评论区外观。
 */
import config from "virtual:theme/config";
import Artalk from "./comments/Artalk.astro";
import Disqus from "./comments/Disqus.astro";
import Giscus from "./comments/Giscus.astro";
import Twikoo from "./comments/Twikoo.astro";
import Waline from "./comments/Waline.astro";

interface Props {
	/** 各实现共享的页面路径（与 orchid-blog 口径一致：/posts/<id>、/guestbook，均无尾斜杠） */
	path: string;
	/** 页面级开关（文章传 frontmatter comment；缺省 true） */
	enabled?: boolean;
	/** Disqus 用页面标题（缺省回退 path） */
	title?: string;
}

const { path, enabled = true, title } = Astro.props;
const c = config.comment;
// 配置边界校验（§4.62）：provider 启用但对应后端地址/仓库信息为空（schema 默认空串）时
// 不挂载评论区——空 server 会让 SDK 向站点同源发请求并报错
const providerReady =
	(c.provider === "artalk" && c.artalk.server.trim() !== "") ||
	(c.provider === "twikoo" && c.twikoo.envId.trim() !== "") ||
	(c.provider === "waline" && c.waline.serverURL.trim() !== "") ||
	(c.provider === "giscus" &&
		c.giscus.repo.trim() !== "" &&
		c.giscus.repoId.trim() !== "") ||
	(c.provider === "disqus" && c.disqus.shortname.trim() !== "");
const active = enabled && c.enabled && c.provider !== "none" && providerReady;
---

{
  active && (
    <section class="comments reveal" id="comments">
      <h2 class="section-title">{c.title}</h2>
      {c.provider === 'artalk' && <Artalk path={path} />}
      {c.provider === 'twikoo' && <Twikoo path={path} />}
      {c.provider === 'waline' && <Waline path={path} />}
      {c.provider === 'giscus' && <Giscus />}
      {c.provider === 'disqus' && <Disqus path={path} title={title} />}
    </section>
  )
}
