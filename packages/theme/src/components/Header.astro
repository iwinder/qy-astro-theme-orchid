---
import config from 'virtual:theme/config';
const { title, nav } = config;
---

<header class="border-b border-line">
  <div class="mx-auto flex h-14 w-full max-w-[720px] items-center justify-between px-5">
    <a href="/" class="text-[15px] font-semibold tracking-wide text-ink hover:text-accent">
      {title}
    </a>
    <nav class="flex items-center gap-5">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-[13px] text-muted transition-colors hover:text-accent"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
