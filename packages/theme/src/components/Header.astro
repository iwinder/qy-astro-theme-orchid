---
import config from "virtual:theme/config";
import { t } from "../i18n/index.js";
import { resolveSiteImage } from "../utils/image.js";

const { title, nav, logo } = config;
/* 三格式图源（§4.97）：相对路径相对站点 src/ 构建期解析 */
const logoSrc = logo ? await resolveSiteImage(logo) : "";

/** 外链统一属性（§4.16）：新窗口 + noopener */
function externalAttrs(external?: boolean) {
	return external ? { target: "_blank", rel: "noopener noreferrer" } : {};
}

/** 内置页导航高亮 key（body[data-page] ↔ .nav-link[data-nav]） */
function navKey(href: string): string | null {
	if (href === "/") return "home";
	if (href === "/archive" || href.startsWith("/archive/")) return "archive";
	if (href === "/tags" || href.startsWith("/tags/")) return "tags";
	if (href === "/about" || href.startsWith("/about/")) return "about";
	if (href === "/friends" || href.startsWith("/friends/")) return "friends";
	if (href === "/guestbook" || href.startsWith("/guestbook/"))
		return "guestbook";
	if (href === "/sponsor" || href.startsWith("/sponsor/")) return "sponsor";
	return null;
}

/* hue 调色面板（M3b-b5）：预设色板为代码级常量；运行时覆写 --accent-h，s/l 保持配置值 */
const hueEnabled = config.huePanel.enabled;

/* 壁纸控制按钮（§4.98）：switchable 模式循环切换 + 视频播放器控制；
   无图源时切换按钮无意义不渲染，无视频源时播放器按钮不渲染（构建期判定） */
const wp = config.wallpaper;
const wpSwitchable = wp.switchable && wp.src.desktop.length > 0;
const wpPlayer = wp.playerEnable && wp.src.playerUrl.length > 0;
const wpPlayerMulti = wpPlayer && wp.src.playerUrl.length > 1;
const presetHues = [0, 30, 60, 100, 140, 170, 210, 250, 290, 330];
---

<header class="site-header">
  <div class="shell header-inner">
    {/* Logo（§4.20）：配置非空时标题左侧渲染，与文字同行 */}
    <a class="site-title" href="/">
      {logo && <img class="nav-logo" src={logoSrc} alt={config.title} />}
      {title}
    </a>
    <nav class="site-nav" id="siteNav" aria-label={t('mainNav')}>
      {
        nav.map((item) => {
          const key = item.href ? navKey(item.href) : null;
          /* 子菜单（§4.16）：父项有 href 则可点击跳转（hover 展开）；无 href 仅作下拉入口 */
          if (item.children.length > 0) {
            return (
              <div class="nav-item has-sub">
                {item.href ? (
                  <a class="nav-link" data-nav={key ?? undefined} href={item.href} {...externalAttrs(item.external)}>
                    {item.label}
                    {/* 父项下拉 chevron（§4.27）：对齐 orchid-blog 标识，子菜单展开时旋转 */}
                    <svg class="nav-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                  </a>
                ) : (
                  <button class="nav-link nav-sub-toggle" type="button" aria-expanded="false">
                    {item.label}
                    <svg class="nav-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                  </button>
                )}
                <div class="nav-sub">
                  {item.children.map((c) => {
                    const ck = c.href ? navKey(c.href) : null;
                    return (
                      <a class="nav-sub-link" data-nav={ck ?? undefined} href={c.href} {...externalAttrs(c.external)}>
                        {c.label}
                      </a>
                    );
                  })}
                </div>
              </div>
            );
          }
          return (
            <a class="nav-link" data-nav={key ?? undefined} href={item.href ?? '#'} {...externalAttrs(item.external)}>
              {item.label}
            </a>
          );
        })
      }
    </nav>
    <div class="header-actions">
      {
        /* 搜索（§4.56）：置于 actions 首位，其余按钮跟在其后；对齐参考项目形态——
           桌面为导航栏内联搜索框（输入即搜），移动端退化为 icon 按钮 + 浮层（含输入框）；
           索引由构建期 pagefind 生成，dev 下降级提示 */
      }
      <div class="search-wrap">
        <div class="nav-search" title={t('searchShortcut')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input id="searchInput" type="search" placeholder={t('search')} autocomplete="off" enterkeyhint="search" aria-label={t('search')} />
        </div>
        <button class="icon-btn nav-search-toggle" id="searchToggle" type="button" aria-label={t('search')} aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </button>
        <div class="search-pop" id="searchPop" hidden>
          <div class="search-bar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input id="searchInputM" type="search" placeholder={t('search')} autocomplete="off" enterkeyhint="search" aria-label={t('search')} />
          </div>
          <div class="search-results" id="searchResults" hidden></div>
        </div>
      </div>
      {
        /* 列表形态切换（§4.34→§4.55）：allowSwitch 控制；仅首页/列表页显示（CSS data-page 显隐） */
      }
      {config.postList.allowSwitch && (
        <button
          class="icon-btn layout-switch"
          id="layoutSwitch"
          type="button"
          aria-label={t('layoutSwitch')}
          aria-pressed="false"
          title={t('layoutSwitch')}
        >
          <svg class="ic-list" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
          <svg class="ic-grid" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        </button>
      )}
      {
        hueEnabled && (
          <div class="palette-wrap">
            <button class="icon-btn" id="paletteToggle" type="button" aria-label={t('palette')} aria-expanded="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>
            </button>
            <div class="palette-pop" id="palettePop" hidden>
              <div class="palette-title">{t('paletteTitle')}</div>
              <div class="palette-row">
                {presetHues.map((h) => (
                  <button
                    class="swatch"
                    type="button"
                    style={`--sw: hsl(${h} var(--accent-s) var(--accent-l))`}
                    data-hue={h}
                    aria-label={t('hueValue', { n: h })}
                  />
                ))}
              </div>
              <input class="hue-slider" id="hueSlider" type="range" min="0" max="360" step="1" aria-label={t('paletteTitle')} />
              <div class="palette-foot">
                <span class="hue-badge" id="hueBadge" />
                <button class="palette-reset" id="hueReset" type="button">{t('reset')}</button>
              </div>
            </div>
          </div>
        )
      }
      {
        /* 壁纸模式切换（§4.98）：switchable 开启且有图源时渲染，点击循环
           banner→fullscreen→overlay→none 并持久化 localStorage('qy-wallpaper') */
      }
      {wpSwitchable && (
        <button class="icon-btn" id="wallpaperModeToggle" type="button" aria-label={t('wpMode')} title={t('wpMode')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
        </button>
      )}
      {
        /* 视频壁纸播放器控制（§4.98）：播放/暂停 + 多视频时的前后切换；
           play/pause 双图标由 stage[data-video-playing] 控制显隐 */
      }
      {wpPlayer && (
        <>
          {wpPlayerMulti && (
            <button class="icon-btn" id="wpPlayerPrev" type="button" aria-label={t('wpPrev')} title={t('wpPrev')}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="19 20 9 12 19 4 19 20"/><line x1="5" y1="19" x2="5" y2="5"/></svg>
            </button>
          )}
          <button class="icon-btn" id="wpPlayerToggle" type="button" aria-label={t('wpPlay')} title={t('wpPlay')}>
            <svg class="i-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            <svg class="i-pause" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
          </button>
          {wpPlayerMulti && (
            <button class="icon-btn" id="wpPlayerNext" type="button" aria-label={t('wpNext')} title={t('wpNext')}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 4 15 12 5 20 5 4"/><line x1="19" y1="5" x2="19" y2="19"/></svg>
            </button>
          )}
        </>
      )}
      <button class="icon-btn" id="modeToggle" type="button" aria-label={t('toggleMode')}>
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
      </button>
      <button class="icon-btn nav-burger" id="navToggle" type="button" aria-label={t('menu')} aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>
