---
import { t } from "../i18n/index.js";
/**
 * 相册卡片（M3b-b8）：画廊列表页网格单元，样式对齐设计原型 §9。
 * data-tags（标签数组）与 data-search（名称/描述/地点/标签全文小写）供 gallery-filter 筛选。
 */
import { getLqipStyle } from "../utils/lqip.js";
import { getThumbInfo } from "../utils/thumb.js";

interface Props {
	id: string;
	name: string;
	cover: string;
	description?: string;
	date?: string;
	location?: string;
	tags?: string[];
	photoCount: number;
	encrypted?: boolean;
}

const {
	id,
	name,
	cover,
	description = "",
	date = "",
	location = "",
	tags = [],
	photoCount,
	encrypted = false,
} = Astro.props;

const searchText = [name, description, location, ...tags]
	.join(" ")
	.toLowerCase();
/* §4.106：相册封面用缩略图（点击进详情页看原图，卡片本身无灯箱） */
const thumb = getThumbInfo(cover);
---

<a class="album-card card" href={`/gallery/${id}/`} data-tags={tags.join(',')} data-search={searchText} aria-label={encrypted ? `${name}（${t('encryptedAlbum')}）` : name}>
  <div class="album-cover">
    {cover ? (
      <>
        {/* LQIP 占位渐变（b9.5）：外链封面查不到数据时降级纯色 */}
        <div class="qy-lqip" style={getLqipStyle(cover)} aria-hidden="true"></div>
        <img src={thumb.src} alt={name} loading="lazy" decoding="async" data-lqip />
      </>
    ) : (
      <span class="album-cover-fallback">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="m21 15-4.2-4.2a1.4 1.4 0 0 0-2 0L7 18.6"/></svg>
      </span>
    )}
    {encrypted && (
      <span class="lock-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        {t('encryptedAlbum')}
      </span>
    )}
  </div>
  <div class="album-info">
    <span class="album-name">{name}</span>
    <span class="album-count">{t('galleryPhotos', { n: photoCount })}</span>
  </div>
  {(date || location) && (
    <div class="album-sub">
      {date && <span>{date}</span>}
      {location && <span>{location}</span>}
    </div>
  )}
  {tags.length > 0 && (
    <div class="album-tags">
      {tags.slice(0, 4).map((tag) => <span class="chip">{tag}</span>)}
    </div>
  )}
</a>
