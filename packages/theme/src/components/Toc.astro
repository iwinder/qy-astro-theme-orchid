---
export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
---

{
  items.length > 0 && (
    <aside class="toc" aria-label="目录">
      <div class="toc-title">目 录</div>
      {items.map((h) => (
        <a href={`#${h.slug}`}>{h.text}</a>
      ))}
    </aside>
  )
}
