---
/**
 * Umami 统计。orchid-blog analytics/UmamiAnalytics.astro 移植（去 swup 标记）。
 * 注意：所有 is:inline 脚本必须置于模板顶层（JSX 条件表达式内的脚本体
 * 会被模板编译器按表达式解析，{}/箭头函数会编译失败）；
 * 开关经 define:vars 传入，脚本内自行短路。
 * 外链追踪用 document 级 astro:page-load 监听，VT 换页后自动重扫新 DOM 外链。
 */
interface Props {
	websiteId: string;
	scriptUrl?: string;
	replaysScriptUrl?: string;
	trackOutboundLinks?: boolean;
	collectWebVitals?: boolean;
	replays?: {
		enabled?: boolean;
		sampleRate?: number;
		maskLevel?: "moderate" | "strict";
		maxDuration?: number;
		blockSelector?: string;
	};
}

const {
	websiteId,
	scriptUrl,
	replaysScriptUrl,
	trackOutboundLinks = true,
	collectWebVitals = false,
	replays,
} = Astro.props;

const replaysEnabled = replays?.enabled ?? false;
const replaysSampleRate = replays?.sampleRate ?? 0.15;
const replaysMaskLevel = replays?.maskLevel ?? "moderate";
const replaysMaxDuration = replays?.maxDuration ?? 300000;
const replaysBlockSelector = replays?.blockSelector?.trim();
---

<script
  is:inline
  defer
  src={scriptUrl}
  data-website-id={websiteId}
  data-performance={collectWebVitals ? 'true' : undefined}
></script>

{
  replaysEnabled && (
    <script
      is:inline
      defer
      src={replaysScriptUrl}
      data-website-id={websiteId}
      data-sample-rate={String(replaysSampleRate)}
      data-mask-level={replaysMaskLevel}
      data-max-duration={String(replaysMaxDuration)}
      data-block-selector={replaysBlockSelector || undefined}
    />
  )
}

<script is:inline define:vars={{ outboundEnabled: trackOutboundLinks }}>
  (function () {
    if (!outboundEnabled) return;
    var name = 'outbound-link-click';

    function applyOutboundTracking() {
      document.querySelectorAll('a').forEach(function (a) {
        if (a.host !== window.location.host && !a.getAttribute('data-umami-event')) {
          a.setAttribute('data-umami-event', name);
          a.setAttribute('data-umami-event-url', a.href);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', applyOutboundTracking, { once: true });
    } else {
      applyOutboundTracking();
    }

    // VT 换页后重扫新 DOM 中的外链
    document.addEventListener('astro:page-load', applyOutboundTracking);
  })();
</script>
