---
import config from "virtual:theme/config";
import { t } from "../i18n/index.js";
import {
	collectCategories,
	collectTags,
	daysSince,
	type PostLike,
} from "../utils.js";
import Calendar from "./Calendar.astro";
import type { TocHeading } from "./Toc.astro";

interface Props {
	/** 全站已发布文章（用于聚合分类/标签/统计） */
	posts: PostLike[];
	/** list：首页/列表页；post：文章详情页（可选 toc widget） */
	variant?: "list" | "post";
	/** 文章标题锚点（variant=post 时供 toc widget 渲染） */
	headings?: TocHeading[];
}

const { posts, variant = "list", headings = [] } = Astro.props;
const isPost = variant === "post";
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
const cats = [...collectCategories(posts).entries()];
const tags = [...collectTags(posts).keys()];

// 标签 widget（§4.48）：仅展示前 count 个热门标签（collectTags 已按文章数降序），
// 其余收进「…更多」入口跳转 /tags/；count=0 表示全部展示。
// §4.51 参数平铺：从 widgets 数组的 tags 项读取
const tagWidget = config.sidebar.widgets.find((w) => w.type === "tags");
const tagCount = tagWidget?.type === "tags" ? tagWidget.count : 12;
const shownTags = tagCount > 0 ? tags.slice(0, tagCount) : tags;
const tagHidden = tags.length - shownTags.length;

const runDays = config.since ? daysSince(config.since) : null;

// widget 开关与顺序（P2 侧栏改造）：config.sidebar.widgets 数组即渲染顺序；
// 两个方向的显隐（对齐参考模板 showOnPostPage/hideOnNonPostPage）：
// showOnPost=false 仅列表页显示；postOnly=true 仅文章页侧栏显示；文章页整体开关由路由层 onPost 把关
// hideOnMobile=true 的 widget 在 <768px 隐藏（§4.49 移动端差异化，CSS .side-hide-m）
const widgets = config.sidebar.widgets.filter(
	(w) => w.enabled && (isPost ? w.showOnPost : !w.postOnly),
);

// §4.50 sticky 侧栏：按 position 拆两组——top 组普通流式，sticky 组包进粘性容器
// （≥768px 跟随滚动，CSS .side-sticky）；组内保持 widgets 数组顺序
const topWidgets = widgets.filter((w) => w.position !== "sticky");
const stickyWidgets = widgets.filter((w) => w.position === "sticky");

// 公告 widget（P1-17）：content 留空整卡不渲染
const ann = config.announcement;
const showAnnouncement = ann.content.trim() !== "";
const annLink = Boolean(ann.link.text && ann.link.url);

// 个人资料卡（§4.15）：头像/昵称/简介至少配一项才渲染
const profile = config.profile;
const showProfile = Boolean(profile.name || profile.avatar || profile.bio);
const profileInitial = (profile.name || "?").trim().slice(0, 1) || "?";

// 广告 widget（P2 保留项，默认关）：enabled + 至少一项内容 + 未过期才渲染
const ad = config.advertisement;
const adExpired = ad.expireDate ? new Date() > new Date(ad.expireDate) : false;
const showAd =
	ad.enabled && Boolean(ad.image || ad.content || ad.link.text) && !adExpired;

// 友链 widget（决策 8）：与友链页同源 themeConfig.friends.list；
// random=false 时 featured 优先、其余按 weight 降序，取前 count 个。
// §4.51 参数平铺：count/random 从 widgets 数组的 friends 项读取
const fw = config.sidebar.widgets.find((w) => w.type === "friends");
let sideFriends: typeof config.friends.list = [];
if (fw?.type === "friends") {
	const enabled = config.friends.list.filter((f) => f.enabled);
	const pool = fw.random
		? [...enabled].sort(() => Math.random() - 0.5)
		: [...enabled].sort((a, b) => {
				if (a.featured !== b.featured) return a.featured ? -1 : 1;
				return b.weight - a.weight;
			});
	sideFriends = pool.slice(0, fw.count);
}
---

<aside class="sidebar">
  {
    [
      { cls: "side-top", list: topWidgets },
      { cls: "side-sticky", list: stickyWidgets },
    ]
      .filter((g) => g.list.length > 0)
      .map((group) => (
        <div class={group.cls}>
          {group.list.map((w) => (
            <>
        {w.type === 'profile' && showProfile && (
          <section class:list={["side-card", "card", "reveal", "profile-card", { "side-hide-m": w.hideOnMobile }]}>
            <div class="profile-head">
              {profile.url ? (
                <a class="profile-avatar-link" href={profile.url} aria-label={profile.name}>
                  {profile.avatar ? (
                    <img class="profile-avatar" src={profile.avatar} alt={profile.name} loading="lazy" />
                  ) : (
                    <span class="profile-avatar avatar-fallback">{profileInitial}</span>
                  )}
                </a>
              ) : profile.avatar ? (
                <img class="profile-avatar" src={profile.avatar} alt={profile.name} loading="lazy" />
              ) : (
                <span class="profile-avatar avatar-fallback">{profileInitial}</span>
              )}
              <div class="profile-id">
                {profile.url ? (
                  <a class="profile-name" href={profile.url}>{profile.name}</a>
                ) : (
                  <span class="profile-name">{profile.name}</span>
                )}
                <span class="profile-bar" aria-hidden="true" />
              </div>
            </div>
            {profile.bio && <p class="profile-bio">{profile.bio}</p>}
            {profile.links.length > 0 && (
              <div class="profile-links">
                {profile.links.map((lk) => {
                  const external = /^https?:\/\//.test(lk.url);
                  return (
                    <a
                      href={lk.url}
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener noreferrer' : undefined}
                      title={lk.name}
                    >
                      {lk.icon && <span class="profile-link-icon" set:html={lk.icon} />}
                      {lk.showName && <span class="profile-link-name">{lk.name}</span>}
                    </a>
                  );
                })}
              </div>
            )}
          </section>
        )}
        {w.type === 'announcement' && showAnnouncement && (
          <section class:list={["side-card", "card", "reveal", { "side-hide-m": w.hideOnMobile }]} id="announcement">
            <h3>{ann.title}</h3>
            <p class="side-announcement">{ann.content}</p>
            {(annLink || ann.closable) && (
              <div class="side-announcement-foot">
                {annLink && (
                  <a
                    class="btn-ghost"
                    href={ann.link.url}
                    target={ann.link.external ? '_blank' : undefined}
                    rel={ann.link.external ? 'noopener noreferrer' : undefined}
                  >
                    {ann.link.text}
                  </a>
                )}
                {ann.closable && (
                  <button
                    class="side-close"
                    type="button"
                    aria-label={t('closeAnnouncement')}
                    onclick="this.closest('section').style.display='none'"
                  >
                    ✕
                  </button>
                )}
              </div>
            )}
          </section>
        )}
        {w.type === 'categories' && cats.length > 0 && (
          <section class:list={["side-card", "card", "reveal", { "side-hide-m": w.hideOnMobile }]}>
            <h3>{t('categories')}</h3>
            <div class="cat-list">
              {cats.map(([name, list]) => (
                <a href={`/categories/${encodeURIComponent(name)}/`}>
                  <span>{name}</span>
                  <span class="count">{list.length}</span>
                </a>
              ))}
            </div>
          </section>
        )}
        {w.type === 'tags' && tags.length > 0 && (
          <section class:list={["side-card", "card", "reveal", { "side-hide-m": w.hideOnMobile }]}>
            <h3>{t('tags')}</h3>
            <div class="side-tags">
              {shownTags.map((tag) => (
                <a class="chip" href={`/tags/${encodeURIComponent(tag)}/`}>
                  {tag}
                </a>
              ))}
              {tagHidden > 0 && (
                <a class="chip chip-more" href="/tags/">{t('tagsMore')}</a>
              )}
            </div>
          </section>
        )}
        {w.type === 'friends' && sideFriends.length > 0 && (
          <section class:list={["side-card", "card", "reveal", { "side-hide-m": w.hideOnMobile }]}>
            <h3>{t('friendLinks')}</h3>
            <div class="side-friends">
              {sideFriends.map((f) => (
                <a href={f.site} target="_blank" rel="noopener" title={f.title}>
                  {f.image ? (
                    <img src={f.image} alt={f.title} loading="lazy" />
                  ) : (
                    <span class="avatar-fallback">{f.title.slice(0, 1)}</span>
                  )}
                  <span>{f.title}</span>
                </a>
              ))}
            </div>
          </section>
        )}
        {w.type === 'calendar' && (
          <Calendar
            lang={config.lang}
            postTooltip={w.postTooltip}
            hideMobile={w.hideOnMobile}
          />
        )}
        {w.type === 'toc' && isPost && config.toc.enabled && tocItems.length > 0 && (
          <section class:list={["side-card", "card", "reveal", "toc-widget", { "side-hide-m": w.hideOnMobile }]}>
            <h3>{t('tocTitle')}</h3>
            <nav class="side-toc">
              {tocItems.map((h) => (
                <a class={`toc-depth-${h.depth}`} href={`#${h.slug}`}>
                  {h.text}
                </a>
              ))}
            </nav>
          </section>
        )}
        {w.type === 'siteInfo' && (
          <section class:list={["side-card", "card", "reveal", { "side-hide-m": w.hideOnMobile }]}>
            <h3>{t('siteInfo')}</h3>
            <div class="site-info">
              <div class="row"><span>{t('posts')}</span><b>{posts.length}</b></div>
              <div class="row"><span>{t('categories')}</span><b>{cats.length}</b></div>
              <div class="row"><span>{t('tags')}</span><b>{tags.length}</b></div>
              {runDays !== null && <div class="row"><span>{t('running')}</span><b>{t('daysCount', { n: runDays })}</b></div>}
            </div>
          </section>
        )}
        {w.type === 'advertisement' && showAd && (
          <section class:list={["side-card", "card", "reveal", "advertisement-widget", { "side-hide-m": w.hideOnMobile }]} id="advertisement">
            <h3>{ad.title}</h3>
            {ad.closable && (
              <button
                class="ad-close"
                type="button"
                aria-label={t('closeAd')}
                onclick="window.__orchidCloseAd && window.__orchidCloseAd(this)"
              >
                ✕
              </button>
            )}
            <div class="ad-body">
              {ad.image &&
                (ad.imageLink ? (
                  <a href={ad.imageLink} target="_blank" rel="noopener">
                    <img src={ad.image} alt={ad.imageAlt} loading="lazy" />
                  </a>
                ) : (
                  <img src={ad.image} alt={ad.imageAlt} loading="lazy" />
                ))}
              {ad.content && <p>{ad.content}</p>}
              {ad.link.text && (
                <a
                  class="btn-ghost"
                  href={ad.link.url || '#'}
                  target={ad.link.external ? '_blank' : undefined}
                  rel={ad.link.external ? 'noopener noreferrer' : undefined}
                >
                  {ad.link.text}
                </a>
              )}
            </div>
          </section>
        )}
            </>
          ))}
        </div>
      ))
  }
</aside>

<!-- 广告初始化：置于顶层（条件表达式内无法放脚本体）；data-astro-rerun 保证 VT 换页后重绑/重计数。
     displayCount>0 时按 localStorage 计数，超限隐藏当前页的广告卡 -->
<script is:inline data-astro-rerun define:vars={{ adEnabled: showAd, displayCount: ad.displayCount }}>
  (function () {
    window.__orchidCloseAd = function (btn) {
      var wrapper = btn.closest('.advertisement-widget');
      if (!wrapper) return;
      wrapper.style.transition = 'all .3s ease-out';
      wrapper.style.transform = 'translateX(24px)';
      wrapper.style.opacity = '0';
      setTimeout(function () {
        wrapper.style.display = 'none';
      }, 300);
    };
    if (!adEnabled) return;
    var widget = document.getElementById('advertisement');
    if (!widget) return;
    if (displayCount > 0) {
      var key = 'ad-display-advertisement';
      var n = parseInt(localStorage.getItem(key) || '0', 10);
      if (n >= displayCount) {
        widget.style.display = 'none';
        return;
      }
      localStorage.setItem(key, String(n + 1));
    }
  })();
</script>
