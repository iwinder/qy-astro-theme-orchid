---
import { ClientRouter } from "astro:transitions";
import Analytics from "virtual:theme/components/Analytics.astro";
import Footer from "virtual:theme/components/Footer.astro";
import Header from "virtual:theme/components/Header.astro";
import config from "virtual:theme/config";
import { t } from "../i18n/index.js";
import { hexToHsl } from "../utils.js";
import "@windcoder/astro-theme-orchid/styles/global.css";

interface Props {
	title?: string;
	description?: string;
	/** body[data-page]，驱动导航高亮（home/archive/tags/post...） */
	page?: string;
	/** OG 分享图路径（b9.4，文章页传 /og/<slug>.png）；绝对链接依赖站点 site 配置 */
	ogImage?: string;
}

const { title, description = config.description, page, ogImage } = Astro.props;
const pageTitle = title ? `${title} · ${config.title}` : config.title;
const { h, s, l } = hexToHsl(config.accentColor);
---

<!doctype html>
<html lang={config.lang} style={`--accent-h:${h};--accent-s:${s}%;--accent-l:${l}%`} data-accent-h={h}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={config.author} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* OG/Twitter meta（b9.4）：ogImage 仅文章页传入；绝对链接依赖 site 配置 */}
    <meta property="og:type" content={ogImage ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {Astro.site && <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />}
    {ogImage && Astro.site && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <ClientRouter />
    <!-- 深浅模式 boot：先于首帧执行防 FOUC；is:inline 在 VT swap 时不重复执行 -->
    <script is:inline>
      (function(){var m=localStorage.getItem('qy-mode');if(m==='dark'||(!m&&matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark');var h=localStorage.getItem('qy-hue');if(h)document.documentElement.style.setProperty('--accent-h',h);})();
    </script>
  </head>
  <!-- 客户端动态文案载体（i18n，M3b-b5）：app.ts 读取，VT swap 后随新 body 重建 -->
  <script type="application/json" id="qy-ui-labels" set:html={JSON.stringify({ lightbox: t('lightbox'), close: t('close'), prevImage: t('prevImage'), nextImage: t('nextImage'), copy: t('copy'), copied: t('copied'), sharePoster: t('sharePoster'), generatingPoster: t('generatingPoster'), copyLink: t('copyLink'), savePoster: t('savePoster'), scanToRead: t('scanToRead'), author: t('author'), searchLoading: t('searchLoading'), searchNoResults: t('searchNoResults'), searchUnavailable: t('searchUnavailable'), searchTypeSomething: t('searchTypeSomething') })} />
  <body data-page={page}>
    <a class="skip-link" href="#main">{t('skipToContent')}</a>
    <Header />
    <main id="main" class="site-main">
      <div class="shell">
        <slot />
      </div>
    </main>
    <Footer />
    <!-- 站点统计（P1-16）：ID 全空零输出，挂 body 尾与 orchid-blog 口径一致 -->
    <Analytics />
    <button class="back-top" id="backTop" type="button" aria-label={t('backToTop')} hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
    </button>
    <!-- 全局交互（VT 兼容：document 级委托 + astro:page-load 重初始化） -->
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
