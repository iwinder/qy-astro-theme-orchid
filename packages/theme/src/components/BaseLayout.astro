---
import { ClientRouter } from "astro:transitions";
import Analytics from "virtual:theme/components/Analytics.astro";
import Footer from "virtual:theme/components/Footer.astro";
import Header from "virtual:theme/components/Header.astro";
import Live2DWidget from "virtual:theme/components/Live2DWidget.astro";
import MusicPlayer from "virtual:theme/components/MusicPlayer.astro";
import SakuraEffect from "virtual:theme/components/SakuraEffect.astro";
import config from "virtual:theme/config";
import { t } from "../i18n/index.js";
import { hexToHsl } from "../utils.js";
import "@windcoder/astro-theme-orchid/styles/global.css";

interface Props {
	title?: string;
	description?: string;
	/** meta keywords（§4.19）：默认站点级配置，文章页传 frontmatter tags 覆盖 */
	keywords?: string[];
	/** body[data-page]，驱动导航高亮（home/archive/tags/post...） */
	page?: string;
	/** OG 分享图路径（b9.4，文章页传 /og/<slug>.png）；绝对链接依赖站点 site 配置 */
	ogImage?: string;
}

const { title, description = config.description, keywords = config.keywords, page, ogImage } = Astro.props;
const pageTitle = title ? `${title} · ${config.title}` : config.title;
const { h, s, l } = hexToHsl(config.accentColor);
/* 背景壁纸（§4.35）：数组时构建期随机选一张（每页构建各自取，零 JS）；未配置不渲染 */
const wallpaperSrc = Array.isArray(config.wallpaper.src)
	? config.wallpaper.src.length
		? config.wallpaper.src[Math.floor(Math.random() * config.wallpaper.src.length)]
		: ""
	: config.wallpaper.src || "";
const showWallpaper =
	Boolean(wallpaperSrc) && (!config.wallpaper.homeOnly || page === "home");
---

<!doctype html>
<html lang={config.lang} style={`--accent-h:${h};--accent-s:${s}%;--accent-l:${l}%;--page-width:${config.pageWidth}px`} data-accent-h={h} data-color-mode={config.colorMode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {/* keywords（§4.19）：非空才输出；文章页以 tags 覆盖站点级配置 */}
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <meta name="author" content={config.author} />
    {/* favicon（§4.30）：配置非空时按列表输出，theme 指定 light/dark 经 media 按系统深浅切换 */}
    {config.favicon.length > 0
      ? config.favicon.map((f) => (
          <link
            rel="icon"
            href={f.src}
            type={f.type}
            sizes={f.sizes}
            media={f.theme ? `(prefers-color-scheme: ${f.theme})` : undefined}
          />
        ))
      : <link rel="icon" href="/favicon.svg" type="image/svg+xml" />}
    {/* SEO 头部补全（§4.12）：canonical 防重复内容；RSS 供阅读器发现；theme-color 与 global.css :root 同步 */}
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}
    <link rel="alternate" type="application/rss+xml" title={config.title} href={Astro.site ? new URL("rss.xml", Astro.site).href : "/rss.xml"} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f4ef" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#131516" />
    {/* OG/Twitter meta（b9.4）：ogImage 仅文章页传入；绝对链接依赖 site 配置 */}
    <meta property="og:type" content={ogImage ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={config.title} />
    <meta property="og:locale" content={config.lang.replace("-", "_")} />
    {Astro.site && <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />}
    {ogImage && Astro.site && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <ClientRouter />
    <!-- 深浅模式 boot：先于首帧执行防 FOUC；is:inline 在 VT swap 时不重复执行。
         默认模式读 html[data-color-mode]（§4.16 colorMode），用户选择以 localStorage('qy-mode') 优先 -->
    <script is:inline>
      (function(){var m=localStorage.getItem('qy-mode');var d=document.documentElement.dataset.colorMode||'system';if(m==='dark'||(!m&&d==='dark')||(!m&&d==='system'&&matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark');var h=localStorage.getItem('qy-hue');if(h)document.documentElement.style.setProperty('--accent-h',h);})();
    </script>
  </head>
  <!-- 客户端动态文案载体（i18n，M3b-b5）：app.ts 读取，VT swap 后随新 body 重建 -->
  <script type="application/json" id="qy-ui-labels" set:html={JSON.stringify({ lightbox: t('lightbox'), close: t('close'), prevImage: t('prevImage'), nextImage: t('nextImage'), copy: t('copy'), copied: t('copied'), sharePoster: t('sharePoster'), generatingPoster: t('generatingPoster'), copyLink: t('copyLink'), savePoster: t('savePoster'), scanToRead: t('scanToRead'), author: t('author'), searchLoading: t('searchLoading'), searchNoResults: t('searchNoResults'), searchUnavailable: t('searchUnavailable'), searchTypeSomething: t('searchTypeSomething'), codeFoldExpand: t('codeFoldExpand'), codeFoldCollapse: t('codeFoldCollapse') })} />
  <body data-page={page}>
    <a class="skip-link" href="#main">{t('skipToContent')}</a>
    <Header />
    <!-- 背景壁纸（§4.35，banner 单模式）：Header 之后下沉横幅 + 黑蒙层；src 未配置或 homeOnly 非首页不渲染 -->
    {
      showWallpaper && (
        <div
          class="wallpaper-banner"
          style={`--banner-h:${config.wallpaper.height}vh;--banner-dim:${config.wallpaper.dimOpacity};--banner-pos:${config.wallpaper.position}`}
        >
          <img src={wallpaperSrc} alt="" aria-hidden="true" loading="eager" />
          <div class="wallpaper-dim" aria-hidden="true" />
        </div>
      )
    }
    <main id="main" class="site-main">
      <div class="shell">
        <slot />
      </div>
    </main>
    <!-- 列表形态恢复（§4.34）：首帧绘制前应用 localStorage 记忆防闪烁；
         is:inline 在 VT 换页不重执行，跨页返回由 app.ts initPage 接管 -->
    <script is:inline>
      (function(){try{var m=localStorage.getItem('qy-postList');if(m!=='grid')return;var l=document.getElementById('postList');if(!l||l.dataset.allowSwitch!=='true')return;l.classList.add('grid-mode');l.style.setProperty('--col-w',(l.dataset.gridCol||'320')+'px');var b=document.getElementById('layoutSwitch');if(b)b.setAttribute('aria-pressed','true');}catch(e){}})();
    </script>
    <Footer />
    <!-- 站点统计（P1-16）：ID 全空零输出，挂 body 尾与 orchid-blog 口径一致 -->
    <Analytics />
    <!-- 樱花飘落特效（§4.30）：sakura.enabled 开启才渲染 -->
    {config.sakura.enabled && <SakuraEffect density={config.sakura.density} />}
    <!-- 悬浮音乐播放器（§4.36）：music.enabled 且歌单非空才渲染 -->
    {config.music.enabled && config.music.playlist.length > 0 && (
      <MusicPlayer music={config.music} />
    )}
    <!-- Live2D 看板娘（§4.38）：live2d.enabled 且配置了 model 才渲染 -->
    {config.live2d.enabled && config.live2d.model && <Live2DWidget live2d={config.live2d} />}
    <button class="back-top" id="backTop" type="button" aria-label={t('backToTop')} hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
    </button>
    <!-- 全局交互（VT 兼容：document 级委托 + astro:page-load 重初始化） -->
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
