---
/**
 * 显示设置面板（§4.103，对齐 Firefly）：导航栏齿轮入口的三 Tab 浮层
 * （外观/壁纸/特效），集中管理主题色、壁纸模式、全屏布局、壁纸设置、
 * 透明设置与樱花特效的访客级开关，选择持久化 localStorage（键表见 design.md）。
 *
 * 渲染条件：displaySettings.enable=true（BaseLayout 挂载处判定）。
 * Tab 可见性：无可见项的 Tab 不渲染；仅一个 Tab 有内容时 Tab 栏隐藏。
 * 组显隐：模式相关的组带 data-modes 属性（空格分隔的模式组合，特殊值
 * fullscreen-hero 表示 fullscreen 且布局为 hero），由 app.ts 在模式/布局
 * 切换时刷新显隐。开关/滑块初始态由 app.ts 按 localStorage > 配置默认填充。
 */
import config from "virtual:theme/config";
import { t } from "../i18n/index.js";

const ds = config.displaySettings;
const wp = config.wallpaper;
const homeText = wp.common.homeText;

/* ---- 壁纸 Tab 各组可见性（构建期判定，与 app.ts 运行时刷新口径一致） ---- */
const hasImages = wp.src.desktop.length > 0;
/* 壁纸模式组：有图源才有意义 */
const showMode = ds.wallpaperModeSwitchable && hasImages;
/* 全屏布局组：仅 fullscreen 模式下显示（运行时由 data-modes 门控） */
const showFsLayout = ds.fullscreenLayoutSwitchable && hasImages;
/* 壁纸设置组各项 */
const wpSubs = Array.isArray(homeText.subtitle)
	? homeText.subtitle
	: homeText.subtitle
		? [homeText.subtitle]
		: [];
const showHomeText =
	ds.bannerTitleSwitchable &&
	homeText.enable &&
	(Boolean(homeText.title) || wpSubs.length > 0);
/* 轮播：仅 carousel.enable 时显示（配置关时 DOM 只渲染一张图，访客无图可轮，
   语义=「关闭轮播」，与 Firefly 一致其 switchable 依赖配置开启） */
const showCarousel =
	ds.bannerCarouselSwitchable &&
	wp.common.carousel.enable &&
	wp.src.desktop.length > 1;
const wavesCfg =
	typeof wp.common.waves === "boolean"
		? { desktop: wp.common.waves, mobile: wp.common.waves }
		: wp.common.waves;
const showWaves = ds.wavesSwitchable && (wavesCfg.desktop || wavesCfg.mobile);
const gradCfg =
	typeof wp.common.gradient === "boolean"
		? { desktop: wp.common.gradient, mobile: wp.common.gradient }
		: wp.common.gradient;
const showGradient =
	ds.gradientSwitchable && (gradCfg.desktop || gradCfg.mobile);
const showWpSettings =
	showHomeText || showCarousel || showWaves || showGradient;
/* 透明设置组：布尔简写展开为三分项同值 */
const ov =
	typeof ds.overlaySwitchable === "boolean"
		? {
				opacity: ds.overlaySwitchable,
				blur: ds.overlaySwitchable,
				cardOpacity: ds.overlaySwitchable,
			}
		: ds.overlaySwitchable;
const showOverlaySettings = ov.opacity || ov.blur || ov.cardOpacity;
/* 各 Tab 可见性 */
const wallpaperTabVisible =
	showMode || showFsLayout || showWpSettings || showOverlaySettings;
const appearanceTabVisible = ds.themeColorSwitchable && config.huePanel.enabled;
const effectsTabVisible = ds.sakuraSwitchable && config.sakura.enabled;

interface DsTab {
	id: "appearance" | "wallpaper" | "effects";
	label: string;
	icon: string;
}
const tabs: DsTab[] = [];
if (appearanceTabVisible)
	tabs.push({ id: "appearance", label: t("tabAppearance"), icon: "palette" });
if (wallpaperTabVisible)
	tabs.push({ id: "wallpaper", label: t("tabWallpaper"), icon: "image" });
if (effectsTabVisible)
	tabs.push({ id: "effects", label: t("tabEffects"), icon: "star" });
const showTabBar = tabs.length > 1;

/* hue 调色预设（与 Header palette-pop 同一组常量） */
const presetHues = [0, 30, 60, 100, 140, 170, 210, 250, 290, 330];
---

<div
	class="ds-panel"
	id="displaySettingsPanel"
	hidden
	role="dialog"
	aria-label={t("displaySettings")}
	data-def-fs-layout={wp.fullscreen.layout}
	data-def-opacity={wp.overlay.opacity}
	data-def-blur={wp.overlay.blur}
	data-def-card-opacity={wp.overlay.cardOpacity}
>
	{
		showTabBar && (
			<div class="ds-tabs" role="tablist">
				{tabs.map((tab, i) => (
					<button
						class={`ds-tab${i === 0 ? " is-active" : ""}`}
						type="button"
						role="tab"
						aria-selected={i === 0 ? "true" : "false"}
						data-tab={tab.id}
					>
						{tab.icon === "palette" && (
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor" /><circle cx="17.5" cy="10.5" r=".5" fill="currentColor" /><circle cx="8.5" cy="7.5" r=".5" fill="currentColor" /><circle cx="6.5" cy="12.5" r=".5" fill="currentColor" /><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z" /></svg>
						)}
						{tab.icon === "image" && (
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="m21 15-5-5L5 21" /></svg>
						)}
						{tab.icon === "star" && (
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.2 2.2M16.2 16.2l2.2 2.2M5.6 18.4l2.2-2.2M16.2 7.8l2.2-2.2" /></svg>
						)}
						<span>{tab.label}</span>
					</button>
				))}
			</div>
		)
	}
	<div class="ds-body">
		{/* 外观 Tab：迁入现有 hue 调色板（DOM id 保留，app.ts palette 逻辑复用） */}
		{
			appearanceTabVisible && (
				<section
					class="ds-page is-active"
					data-page="appearance"
					role="tabpanel"
				>
					<div class="ds-group">
						<div class="ds-group-title">{t("paletteTitle")}</div>
						<div class="palette-row">
							{presetHues.map((h) => (
								<button
									class="swatch"
									type="button"
									style={`--sw: hsl(${h} var(--accent-s) var(--accent-l))`}
									data-hue={h}
									aria-label={t("hueValue", { n: h })}
								/>
							))}
						</div>
						<input
							class="hue-slider"
							id="hueSlider"
							type="range"
							min="0"
							max="360"
							step="1"
							aria-label={t("paletteTitle")}
						/>
						<div class="palette-foot">
							<span class="hue-badge" id="hueBadge" />
							<button class="palette-reset" id="hueReset" type="button">
								{t("reset")}
							</button>
						</div>
					</div>
				</section>
			)
		}
		{/* 壁纸 Tab */}
		{
			wallpaperTabVisible && (
				<section
					class={`ds-page${appearanceTabVisible ? "" : " is-active"}`}
					data-page="wallpaper"
					role="tabpanel"
				>
					{showMode && (
						<div class="ds-group" data-modes="banner fullscreen overlay none">
							<div class="ds-group-title">{t("wallpaperMode")}</div>
							<div class="ds-mode-grid">
								<button class="ds-mode-btn" type="button" data-mode="banner">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="8" rx="2" /><path d="M3 17h18" /></svg>
									<span>{t("modeBanner")}</span>
								</button>
								<button class="ds-mode-btn" type="button" data-mode="fullscreen">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="m21 15-5-5L5 21" /></svg>
									<span>{t("modeFullscreen")}</span>
								</button>
								<button class="ds-mode-btn" type="button" data-mode="overlay">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><rect x="6" y="6" width="12" height="12" rx="1.5" fill="currentColor" opacity="0.25" stroke="none" /></svg>
									<span>{t("modeOverlay")}</span>
								</button>
								<button class="ds-mode-btn" type="button" data-mode="none">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="m5 19 14-14" /></svg>
									<span>{t("modeNone")}</span>
								</button>
							</div>
						</div>
					)}
					{showFsLayout && (
						<div class="ds-group" data-modes="fullscreen">
							<div class="ds-group-title">{t("fullscreenLayout")}</div>
							<div class="ds-mode-grid">
								<button class="ds-mode-btn" type="button" data-fs-layout="classic">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="10" rx="2" /><path d="M5 17h14M5 20h9" /></svg>
									<span>{t("layoutClassic")}</span>
								</button>
								<button class="ds-mode-btn" type="button" data-fs-layout="hero">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><rect x="6" y="9" width="12" height="9" rx="1.5" fill="currentColor" opacity="0.25" stroke="none" /><path d="M8 6.5h8" /></svg>
									<span>{t("layoutHero")}</span>
								</button>
							</div>
						</div>
					)}
					{showWpSettings && (
						<div class="ds-group" data-modes="banner fullscreen">
							<div class="ds-group-title">
								<span>{t("wallpaperSettings")}</span>
								<button
									class="ds-group-reset"
									type="button"
									data-reset-group="wallpaper"
									aria-label={t("reset")}
									title={t("reset")}
								>
									↺
								</button>
							</div>
							{showHomeText && (
								<div class="ds-switch-row">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7V5h16v2M9 20h6M12 5v15" /></svg>
									<span class="ds-row-label">{t("homeWallpaperTitle")}</span>
									<button
										class="ds-switch"
										type="button"
										role="switch"
										aria-checked="true"
										data-ds-switch="home-text"
									>
										<span class="ds-switch-knob" />
									</button>
								</div>
							)}
							{showCarousel && (
								<div class="ds-switch-row">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="15" height="15" rx="2" /><path d="M7 7V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2h-2" /></svg>
									<span class="ds-row-label">{t("wallpaperCarousel")}</span>
									<button
										class="ds-switch"
										type="button"
										role="switch"
										aria-checked="true"
										data-ds-switch="carousel"
									>
										<span class="ds-switch-knob" />
									</button>
								</div>
							)}
							{showWaves && (
								<div class="ds-switch-row">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12c2.5-3 5-3 7.5 0s5 3 7.5 0 3.5-2.4 5-1" /><path d="M2 17c2.5-3 5-3 7.5 0s5 3 7.5 0 3.5-2.4 5-1" /></svg>
									<span class="ds-row-label">{t("wavesAnimation")}</span>
									<button
										class="ds-switch"
										type="button"
										role="switch"
										aria-checked="true"
										data-ds-switch="waves"
									>
										<span class="ds-switch-knob" />
									</button>
								</div>
							)}
							{showGradient && (
								<div class="ds-switch-row">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 14c4 0 6 2 9 2s5-2 9-2" opacity="0.4" /><path d="M3 17h18" opacity="0.7" /></svg>
									<span class="ds-row-label">{t("gradientTransition")}</span>
									<button
										class="ds-switch"
										type="button"
										role="switch"
										aria-checked="true"
										data-ds-switch="gradient"
									>
										<span class="ds-switch-knob" />
									</button>
								</div>
							)}
						</div>
					)}
					{showOverlaySettings && (
						<div class="ds-group" data-modes="overlay fullscreen-hero">
							<div class="ds-group-title">
								<span>{t("overlaySettings")}</span>
								<button
									class="ds-group-reset"
									type="button"
									data-reset-group="overlay"
									aria-label={t("reset")}
									title={t("reset")}
								>
									↺
								</button>
							</div>
							{ov.opacity && (
								<div class="ds-slider-row" data-modes="overlay">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" opacity="0.45" /><rect x="3" y="3" width="18" height="18" rx="2" /></svg>
									<span class="ds-row-label">{t("wallpaperOpacity")}</span>
									<input
										class="ds-slider"
										type="range"
										min="0"
										max="100"
										step="1"
										data-ds-slider="opacity"
										aria-label={t("wallpaperOpacity")}
									/>
									<span class="ds-badge" data-ds-badge="opacity" />
								</div>
							)}
							{ov.blur && (
								<div class="ds-slider-row">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3" /><circle cx="12" cy="12" r="7" opacity="0.5" /><circle cx="12" cy="12" r="10" opacity="0.2" /></svg>
									<span class="ds-row-label">{t("backgroundBlur")}</span>
									<input
										class="ds-slider"
										type="range"
										min="0"
										max="20"
										step="1"
										data-ds-slider="blur"
										aria-label={t("backgroundBlur")}
									/>
									<span class="ds-badge" data-ds-badge="blur" />
								</div>
							)}
							{ov.cardOpacity && (
								<div class="ds-slider-row">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="6" rx="1.5" opacity="0.4" /><rect x="3" y="13" width="18" height="7" rx="1.5" /></svg>
									<span class="ds-row-label">{t("cardOpacity")}</span>
									<input
										class="ds-slider"
										type="range"
										min="0"
										max="100"
										step="1"
										data-ds-slider="card-opacity"
										aria-label={t("cardOpacity")}
									/>
									<span class="ds-badge" data-ds-badge="card-opacity" />
								</div>
							)}
						</div>
					)}
				</section>
			)
		}
		{/* 特效 Tab */}
		{
			effectsTabVisible && (
				<section
					class={`ds-page${appearanceTabVisible || wallpaperTabVisible ? "" : " is-active"}`}
					data-page="effects"
					role="tabpanel"
				>
					<div class="ds-group">
						<div class="ds-switch-row">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c-2 3-5 4-8 4 1.5 4 4 6.5 8 7-1-1.5-1-3 0-4.5M12 3c2 3 5 4 8 4-1.5 4-4 6.5-8 7" /><path d="M12 21c0-4 1-6 3-8" opacity="0.5" /></svg>
							<span class="ds-row-label">{t("sakuraEffect")}</span>
							<button
								class="ds-switch"
								type="button"
								role="switch"
								aria-checked="true"
								data-ds-switch="sakura"
							>
								<span class="ds-switch-knob" />
							</button>
						</div>
					</div>
				</section>
			)
		}
	</div>
</div>
