---
/**
 * 站点统计聚合挂载点（P1-16）：BaseLayout body 尾部统一挂载。
 * 各统计 ID 留空即完全不注入对应脚本；全部留空本组件零输出。
 */
import config from "virtual:theme/config";
import GoogleAnalytics from "./analytics/GoogleAnalytics.astro";
import La51Analytics from "./analytics/La51Analytics.astro";
import MicrosoftClarity from "./analytics/MicrosoftClarity.astro";
import UmamiAnalytics from "./analytics/UmamiAnalytics.astro";
import WebVitals from "./analytics/WebVitals.astro";

const a = config.analytics;
const showGA = a.googleAnalyticsId.trim() !== "";
const showClarity = a.microsoftClarityId.trim() !== "";
const showUmami = a.umami.websiteId.trim() !== "";
const show51la = a.la51.id.trim() !== "";
const showWebVitals = a.webVitals.endpoint.trim() !== "";
---

{showGA && <GoogleAnalytics analyticsId={a.googleAnalyticsId} />}
{showClarity && <MicrosoftClarity clarityId={a.microsoftClarityId} />}
{showUmami && <UmamiAnalytics {...a.umami} />}
{show51la && <La51Analytics analyticsId={a.la51.id} sdkUrl={a.la51.sdkUrl} ck={a.la51.ck} autoTrack={a.la51.autoTrack} hashMode={a.la51.hashMode} screenRecord={a.la51.screenRecord} />}
{showWebVitals && <WebVitals {...a.webVitals} />}
