---
/**
 * 樱花飘落特效（§4.30 / §4.101 八维参数对齐 Firefly）：全站 canvas 粒子层，
 * 程序化贝塞尔花瓣（零贴图资产）。
 * - prefers-reduced-motion 自动停用
 * - 页签隐藏暂停、可见时恢复
 * - limitTimes 控制飘落轮数（-1 无限）；配额耗尽后不再重生，花瓣落尽即停帧
 * - VT swap 后 body 重建，经 astro:page-load 重新初始化（模块级单例清理旧动画）
 */
interface Props {
	/** 完整 sakura 配置（schema 已补全默认值），经 data-cfg JSON 传给客户端 */
	cfg?: {
		enabled?: boolean;
		density: number;
		limitTimes: number;
		zIndex: number;
		size: { min: number; max: number };
		opacity: { min: number; max: number };
		speed: {
			horizontal: { min: number; max: number };
			vertical: { min: number; max: number };
			rotation: number;
			fadeSpeed: number;
		};
	};
}

const cfg = Astro.props.cfg;
---

<canvas
	id="sakura-canvas"
	data-cfg={JSON.stringify(cfg)}
	style={`z-index:${cfg?.zIndex ?? 100}`}
	aria-hidden="true"
></canvas>

<style>
	#sakura-canvas {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
</style>

<script>
	let raf = 0;
	let cleanup: (() => void) | null = null;

	function startSakura() {
		// 清理旧实例（VT swap 前的动画循环与监听）
		cleanup?.();

		const canvas = document.getElementById(
			"sakura-canvas",
		) as HTMLCanvasElement | null;
		if (!canvas) return;
		if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		// 八维参数（§4.101）：缺省回退与 schema 默认一致（防 data-cfg 解析失败）
		let cfg: {
			density?: number;
			limitTimes?: number;
			size?: { min: number; max: number };
			opacity?: { min: number; max: number };
			speed?: {
				horizontal: { min: number; max: number };
				vertical: { min: number; max: number };
				rotation: number;
				fadeSpeed: number;
			};
		};
		try {
			cfg = JSON.parse(canvas.dataset.cfg || "{}");
		} catch {
			cfg = {};
		}
		const count = Math.max(1, Number(cfg.density) || 24);
		const sizeR = cfg.size ?? { min: 0.5, max: 1.1 };
		const opaR = cfg.opacity ?? { min: 0.3, max: 0.9 };
		const spd = cfg.speed ?? {
			horizontal: { min: -1.7, max: -1.2 },
			vertical: { min: 1.5, max: 2.2 },
			rotation: 0.03,
			fadeSpeed: 0.03,
		};
		const rand = (min: number, max: number) => min + Math.random() * (max - min);

		const dpr = Math.min(window.devicePixelRatio || 1, 2);

		let w = 0;
		let h = 0;
		const resize = () => {
			w = window.innerWidth;
			h = window.innerHeight;
			canvas.width = w * dpr;
			canvas.height = h * dpr;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		};
		resize();
		window.addEventListener("resize", resize);

		// 3 档粉调色板（对齐参考站观感）
		const colors = ["#ffd7e2", "#ffc0d0", "#fdaec5"];
		// 花瓣基准尺寸（px）：size 配置为其倍数区间
		const BASE_SIZE = 14;

		interface Petal {
			x: number;
			y: number;
			size: number;
			/** 水平漂移速度（负值向左，§4.101 speed.horizontal） */
			vx: number;
			/** 下落速度（§4.101 speed.vertical） */
			vy: number;
			rot: number;
			color: string;
			alpha: number;
			/** 生命帧数：超过后进入临终淡出（fadeSpeed），alpha 耗尽即重生 */
			life: number;
			age: number;
			dead: boolean;
		}

		const spawn = (randomY = false): Petal => {
			const i = Math.floor(Math.random() * colors.length);
			return {
				x: Math.random() * w,
				y: randomY ? Math.random() * h : -20,
				size: BASE_SIZE * rand(sizeR.min, sizeR.max),
				vx: rand(spd.horizontal.min, spd.horizontal.max),
				vy: rand(spd.vertical.min, spd.vertical.max),
				rot: Math.random() * Math.PI * 2,
				color: colors[i] ?? colors[0]!,
				alpha: rand(opaR.min, opaR.max),
				life: 480 + Math.random() * 720,
				age: 0,
				dead: false,
			};
		};

		// limitTimes 飘落轮数（§4.101）：-1 无限；>=1 时总重生配额 = 轮数 × 花瓣数，
		// 耗尽后不再重生，花瓣落尽即停止动画
		let quota =
			cfg.limitTimes === undefined || cfg.limitTimes < 0
				? Number.POSITIVE_INFINITY
				: cfg.limitTimes * count;

		const petals: Petal[] = Array.from({ length: count }, () => spawn(true));

		// 程序化花瓣：两段贝塞尔拼出泪滴形
		const drawPetal = (p: Petal) => {
			const s = p.size;
			ctx.save();
			ctx.translate(p.x, p.y);
			ctx.rotate(p.rot);
			ctx.globalAlpha = p.alpha;
			ctx.fillStyle = p.color;
			ctx.beginPath();
			ctx.moveTo(0, -s);
			ctx.bezierCurveTo(s * 0.9, -s * 0.6, s * 0.7, s * 0.6, 0, s);
			ctx.bezierCurveTo(-s * 0.7, s * 0.6, -s * 0.9, -s * 0.6, 0, -s);
			ctx.fill();
			ctx.restore();
		};

		// 重生：消耗配额；配额耗尽标记 dead（不再绘制）
		const respawn = (p: Petal) => {
			if (quota > 0) {
				quota--;
				Object.assign(p, spawn());
			} else {
				p.dead = true;
			}
		};

		let paused = false;
		const tick = () => {
			if (paused) return;
			ctx.clearRect(0, 0, w, h);
			let alive = 0;
			for (const p of petals) {
				if (p.dead) continue;
				alive++;
				p.age++;
				// 临终淡出（fadeSpeed）：寿命耗尽后 alpha 递减至 0 重生
				if (p.age > p.life) {
					p.alpha -= spd.fadeSpeed;
					if (p.alpha <= 0) {
						respawn(p);
						continue;
					}
				}
				p.y += p.vy;
				p.x += p.vx;
				p.rot += spd.rotation;
				if (p.y > h + 30 || p.x < -40 || p.x > w + 40) respawn(p);
				else drawPetal(p);
			}
			if (alive === 0) return; // 配额耗尽且花瓣落尽：停止循环
			raf = requestAnimationFrame(tick);
		};

		const onVisibility = () => {
			if (document.hidden) {
				paused = true;
				cancelAnimationFrame(raf);
			} else if (paused) {
				paused = false;
				raf = requestAnimationFrame(tick);
			}
		};
		document.addEventListener("visibilitychange", onVisibility);

		raf = requestAnimationFrame(tick);

		cleanup = () => {
			paused = true;
			cancelAnimationFrame(raf);
			window.removeEventListener("resize", resize);
			document.removeEventListener("visibilitychange", onVisibility);
			cleanup = null;
		};
	}

	// ClientRouter 下 astro:page-load 首载与每次导航都会触发
	document.addEventListener("astro:page-load", startSakura);
</script>
