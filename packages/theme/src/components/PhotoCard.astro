---
/**
 * 照片卡（M3b-b8）：详情页瀑布流单元。
 * data-lightbox-item + 外层 data-lightbox-group 容器（路由页提供）
 * 供灯箱（PhotoSwipe，§4.69）点击组浏览（app.ts 绑定委托，加密解密注入后经
 * showDecrypted → initLightbox 重预置生效）。
 */
import { getLqipStyle } from "../utils/lqip.js";
import { getThumbInfo } from "../utils/thumb.js";

interface Props {
	src: string;
	alt?: string;
}

const { src, alt = "" } = Astro.props;
/* §4.106：列表瀑布流用 480 宽缩略图，data-full-* 供灯箱打开原图（原图宽高） */
const thumb = getThumbInfo(src);
---

<figure class="gallery-photo" data-lightbox-item>
  {/* LQIP 占位渐变（b9.5）：src 支持外链，getLqipStyle 查不到时降级纯色 */}
  <div class="qy-lqip" style={getLqipStyle(src)} aria-hidden="true"></div>
  <img
    src={thumb.src}
    alt={alt}
    loading="lazy"
    decoding="async"
    data-lqip
    data-full-src={thumb.full}
    data-full-width={thumb.width}
    data-full-height={thumb.height}
  />
</figure>
