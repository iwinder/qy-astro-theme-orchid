---
/**
 * 照片卡（M3b-b8）：详情页瀑布流单元。
 * data-lightbox-item + 外层 data-lightbox-group 容器（路由页提供）
 * 供灯箱（PhotoSwipe，§4.69）点击组浏览（app.ts 绑定委托，加密解密注入后经
 * showDecrypted → initLightbox 重预置生效）。
 */
import { getLqipStyle } from "../utils/lqip.js";

interface Props {
	src: string;
	alt?: string;
}

const { src, alt = "" } = Astro.props;
---

<figure class="gallery-photo" data-lightbox-item>
  {/* LQIP 占位渐变（b9.5）：src 支持外链，getLqipStyle 查不到时降级纯色 */}
  <div class="qy-lqip" style={getLqipStyle(src)} aria-hidden="true"></div>
  <img src={src} alt={alt} loading="lazy" decoding="async" data-lqip />
</figure>
