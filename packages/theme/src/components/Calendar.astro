---
/**
 * 侧栏日历 + 活跃度热力图（P2 侧栏改造）。
 * 月视图（周一起始，当月有文章日高亮）+ 近 12 个月热力图（每月 4 段，透明度 5 档）：
 *   顶部月份标签（§4.43），整列可点击跳转对应月份，单元悬停提示月份第几周 · 几篇。
 * 年月标签可点击展开年月选择器（§4.47：年步进 + 12 月网格、未来月置灰），非当月时头部出现「回到本月」按钮。
 * 数据复用 /api/allPostMeta.json（加密文章已在端点侧排除）。
 * 热力图下方文章列表（§4.40，§4.43 移至热力图下）：默认当月全部，点选有文章日期过滤当日，再点取消；
 *   按时间倒序，左侧标题右侧日期；条目悬停全文 title 可经 widgets 数组 calendar 项 specificConfig.postTooltip 开启（§4.41），默认关。
 * <qy-calendar> 为 VT 安全 custom element：is:inline + customElements.get 防重复 define，
 * 元数据缓存在 window.__qyAllPostMetaCache（与 random-posts 共用）。
 */
import { t } from "../i18n/index.js";

interface Props {
	/** 站点语言（决定月份/星期文案的 locale） */
	lang?: string;
	/** 日历下方文章列表条目悬停显示全文 title（§4.41）；默认关 */
	postTooltip?: boolean;
	/** 移动端（<768px）隐藏整个 widget（§4.49）；默认否 */
	hideMobile?: boolean;
}

const { lang = "zh-CN", postTooltip = false, hideMobile = false } = Astro.props;
---

<section class:list={["side-card", "card", "reveal", "calendar-widget", { "side-hide-m": hideMobile }]}>
  <!-- §4.47：「日历」标题移除，年月标签即卡片头部（加粗、可点选年月） -->
  <qy-calendar
    data-lang={lang}
    data-api-url="/api/allPostMeta.json"
    data-label-posts={t('dayPostsCount')}
    data-label-heat-week={t('heatWeekTip')}
    data-label-home={t('calendarHome')}
    data-label-pick={t('calendarPick')}
    data-post-tooltip={postTooltip ? '1' : '0'}
  ></qy-calendar>
</section>

<script is:inline>
  if (!customElements.get('qy-calendar')) {
    customElements.define(
      'qy-calendar',
      class extends HTMLElement {
        connectedCallback() {
          // 每次 connected 重建月视图：VT 往返后回到当月是期望行为
          this.render();
        }
        getMeta() {
          if (window.__qyAllPostMetaCache) {
            return Promise.resolve(window.__qyAllPostMetaCache);
          }
          return fetch(this.dataset.apiUrl)
            .then((r) => r.json())
            .then((data) => {
              window.__qyAllPostMetaCache = data;
              return data;
            })
            .catch(() => null);
        }
        render() {
          var self = this;
          this.getMeta().then(function (meta) {
            if (!meta) return;
            // key: YYYY-MM-DD（本地时区） → 当日文章数
            var byDay = {};
            meta.forEach(function (p) {
              var d = new Date(p.published);
              var key =
                d.getFullYear() +
                '-' +
                String(d.getMonth() + 1).padStart(2, '0') +
                '-' +
                String(d.getDate()).padStart(2, '0');
              byDay[key] = (byDay[key] || 0) + 1;
            });
            var locale = self.dataset.lang || 'zh-CN';
            var postsLabel = self.dataset.labelPosts || '{n}';
            // 热力图单元悬停模板（§4.43）：{m}=月份短文案、{w}=第几周、{n}=篇数
            var weekTip = self.dataset.labelHeatWeek || '{m}第{w}周 · {n}';
            // 「回到本月」按钮与年月标签按钮的 title/aria 文案（§4.47）
            var homeLabel = self.dataset.labelHome || '';
            var pickLabel = self.dataset.labelPick || '';
            var today = new Date();
            var thisMonth = new Date(today.getFullYear(), today.getMonth(), 1);
            var cur = new Date(thisMonth);
            // 年月选择器年份下界（§4.47）：数据最早文章年份，无文章则为当年（须在 today 声明后）
            var minYear = today.getFullYear();
            meta.forEach(function (p) {
              var y = new Date(p.published).getFullYear();
              if (y < minYear) minYear = y;
            });
            var fmtMonth = new Intl.DateTimeFormat(locale, {
              year: 'numeric',
              month: 'long',
            });
            var fmtWeek = new Intl.DateTimeFormat(locale, { weekday: 'narrow' });
            // 热力图悬停月份短文案（§4.43）：zh="10月"、en="Oct"
            var fmtMonthShort = new Intl.DateTimeFormat(locale, { month: 'short' });
            // 周一起始的星期表头（2024-01-01 恰好是周一）
            var weekHeads = [];
            for (var i = 0; i < 7; i++) {
              weekHeads.push(fmtWeek.format(new Date(2024, 0, 1 + i)));
            }
            var tooltip = function (key, n) {
              return key + ' · ' + postsLabel.replace('{n}', n);
            };
            // 与 byDay 一致的 YYYY-MM-DD key（本地时区），列表过滤用
            var dayKey = function (p) {
              var d = new Date(p.published);
              return (
                d.getFullYear() +
                '-' +
                String(d.getMonth() + 1).padStart(2, '0') +
                '-' +
                String(d.getDate()).padStart(2, '0')
              );
            };
            var esc = function (s) {
              return String(s).replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
              });
            };
            // 列表条目日期（§4.43）：两位月/日，如 10/08
            var fmtItemDate = new Intl.DateTimeFormat(locale, { month: '2-digit', day: '2-digit' });
            // 当前选中的日期 key（null = 未选中，列表显示当月全部）
            var selKey = null;
            // 文章列表条目悬停显示全文 title（§4.41），默认关
            var postTip = self.dataset.postTooltip === '1';
            // 年月选择器状态（§4.47）：展开态 + 选择器年份（打开时同步为当前浏览年份）
            var pickOpen = false;
            var pickYear = today.getFullYear();

            // 年月选择器（§4.47）：年步进行（minYear~今年，边界置灰）+ 12 月网格（未来月置灰、当前浏览月高亮）
            var pickerHtml = function () {
              if (!pickOpen) return '';
              var cy = cur.getFullYear();
              var cm = cur.getMonth();
              var thisYear = today.getFullYear();
              var html =
                '<div class="cal-picker" role="group" aria-label="' + esc(pickLabel) + '">' +
                '<div class="cal-picker-row">' +
                '<button type="button" class="cal-py" data-dir="-1" aria-label="prev year"' +
                (pickYear <= minYear ? ' disabled' : '') +
                '>&#8249;</button>' +
                '<b class="cal-py-label">' + pickYear + '</b>' +
                '<button type="button" class="cal-py" data-dir="1" aria-label="next year"' +
                (pickYear >= thisYear ? ' disabled' : '') +
                '>&#8250;</button>' +
                '</div><div class="cal-picker-months">';
              for (var m = 0; m < 12; m++) {
                var d = new Date(pickYear, m, 1);
                var future = d > thisMonth;
                var on = pickYear === cy && m === cm;
                html +=
                  '<button type="button" class="cal-pm' + (on ? ' on' : '') +
                  '" data-m="' + m + '"' + (future ? ' disabled' : '') + '>' +
                  fmtMonthShort.format(d) + '</button>';
              }
              return html + '</div></div>';
            };

            var monthHtml = function () {
              var y = cur.getFullYear();
              var m = cur.getMonth();
              var lead = (new Date(y, m, 1).getDay() + 6) % 7;
              var days = new Date(y, m + 1, 0).getDate();
              // 是否当前月（§4.47）：非当月才渲染「回到本月」按钮
              var isThisMonth = y === thisMonth.getFullYear() && m === thisMonth.getMonth();
              var html =
                '<div class="cal-head">' +
                '<button type="button" class="cal-nav" data-dir="-1" aria-label="prev">&#8249;</button>' +
                // 年月标签改为可点按钮（§4.47）：点击开合年月选择器
                '<button type="button" class="cal-month' + (pickOpen ? ' open' : '') +
                '" aria-expanded="' + pickOpen + '" title="' + esc(pickLabel) + '">' +
                fmtMonth.format(cur) + '</button>' +
                '<span class="cal-head-r">' +
                '<button type="button" class="cal-nav" data-dir="1" aria-label="next">&#8250;</button>' +
                (isThisMonth
                  ? ''
                  : '<button type="button" class="cal-home" title="' + esc(homeLabel) +
                    '" aria-label="' + esc(homeLabel) + '">&#8634;</button>') +
                '</span>' +
                '</div>' +
                pickerHtml() +
                '<div class="cal-grid">';
              for (var i = 0; i < 7; i++) {
                html += '<span class="cal-week">' + weekHeads[i] + '</span>';
              }
              for (var i = 0; i < lead; i++) {
                html += '<span class="cal-day dim"></span>';
              }
              for (var day = 1; day <= days; day++) {
                var key =
                  y + '-' + String(m + 1).padStart(2, '0') + '-' + String(day).padStart(2, '0');
                var n = byDay[key] || 0;
                var cls = 'cal-day';
                if (n > 0) cls += ' has-post';
                if (selKey && key === selKey) cls += ' sel';
                if (y === today.getFullYear() && m === today.getMonth() && day === today.getDate()) {
                  cls += ' today';
                }
                html +=
                  '<span class="' + cls + '"' +
                  (n > 0
                    ? ' data-key="' + key + '" role="button" tabindex="0" title="' + tooltip(key, n) + '"'
                    : '') +
                  '>' + day + '</span>';
              }
              return html + '</div>';
            };

            // 热力图下方文章列表（§4.40，§4.43 移至热力图下，§4.43 修正去统计标题）：默认当月全部，
            // 选中日期则只列当日；按时间倒序，左侧标题右侧日期，超宽标题省略号截断
            var dayListHtml = function () {
              var ym = cur.getFullYear() + '-' + String(cur.getMonth() + 1).padStart(2, '0');
              var list = meta.filter(function (p) {
                if (selKey) return dayKey(p) === selKey;
                return dayKey(p).slice(0, 7) === ym;
              });
              // 时间倒序（filter 返回新数组，原地 sort 安全）
              list.sort(function (a, b) {
                return new Date(b.published) - new Date(a.published);
              });
              var html = '<div class="cal-list">';
              if (list.length) {
                html += '<div class="cal-list-items">';
                list.forEach(function (p) {
                  var d = new Date(p.published);
                  html +=
                    '<a class="cal-post" href="/posts/' + p.id + '/"' +
                    (postTip ? ' title="' + esc(p.title) + '"' : '') +
                    '><span class="cal-post-title">' + esc(p.title) + '</span>' +
                    '<time class="cal-post-date" datetime="' + dayKey(p) + '">' +
                    fmtItemDate.format(d) + '</time></a>';
                });
                html += '</div>';
              }
              return html + '</div>';
            };

            // 今年 1-12 月热力图（§4.44，原近 12 个月）：还原 orchid-blog 原版形态——
            // 月份标签独立一行（grid 12 列），下方 48 个正方形小格子平铺 12×4；
            // 透明度 5 档 0 / .45 / .65 / .85 / 1，格子悬停提示月份第几周 · 几篇、点击跳转对应月份；
            // 未来月份格子不渲染为按钮（月视图不允许翻到未来），仅作占位展示
            var heatHtml = function () {
              var y = today.getFullYear();
              var labels = '';
              var cells = '';
              for (var m = 0; m < 12; m++) {
                var d = new Date(y, m, 1);
                var days = new Date(y, m + 1, 0).getDate();
                var buckets = [0, 0, 0, 0];
                for (var day = 1; day <= days; day++) {
                  var w = Math.min(Math.floor((day - 1) / 7), 3);
                  var key =
                    y + '-' + String(m + 1).padStart(2, '0') + '-' + String(day).padStart(2, '0');
                  buckets[w] += byDay[key] || 0;
                }
                var mShort = fmtMonthShort.format(d);
                var future = d > thisMonth;
                labels += '<b class="cal-heat-label">' + (m + 1) + '</b>';
                for (var b = 0; b < 4; b++) {
                  var n = buckets[b];
                  var o = n === 0 ? 0 : n < 3 ? 0.45 : n < 6 ? 0.65 : n < 10 ? 0.85 : 1;
                  cells +=
                    '<i class="cal-heat-cell" data-y="' +
                    y +
                    '" data-m="' +
                    m +
                    '" style="--o:' +
                    o +
                    '"' +
                    (future ? '' : ' role="button" tabindex="0"') +
                    ' title="' +
                    esc(weekTip.replace('{m}', mShort).replace('{w}', b + 1).replace('{n}', n)) +
                    '"></i>';
                }
              }
              return (
                '<div class="cal-heat-labels">' +
                labels +
                '</div><div class="cal-heat-grid">' +
                cells +
                '</div>'
              );
            };

            var build = function () {
              // 渲染顺序（§4.43）：月视图 → 热力图 → 文章列表
              self.innerHTML =
                monthHtml() + '<div class="cal-heat">' + heatHtml() + '</div>' + dayListHtml();
              self.querySelectorAll('.cal-nav[data-dir]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                  var dir = parseInt(btn.dataset.dir, 10);
                  var next = new Date(cur.getFullYear(), cur.getMonth() + dir, 1);
                  // 不允许翻到未来月份
                  if (next > thisMonth) return;
                  cur = next;
                  selKey = null; // 翻月取消日期选中，列表回到当月全部
                  build();
                });
              });
              // 年月标签开合选择器（§4.47）：打开时同步选择器年份为当前浏览年份
              var monthBtn = self.querySelector('.cal-month');
              if (monthBtn) {
                monthBtn.addEventListener('click', function () {
                  pickOpen = !pickOpen;
                  if (pickOpen) pickYear = cur.getFullYear();
                  build();
                });
              }
              // 回到本月（§4.47）：仅非当月渲染；同时收起选择器、取消日期选中
              var homeBtn = self.querySelector('.cal-home');
              if (homeBtn) {
                homeBtn.addEventListener('click', function () {
                  cur = new Date(thisMonth.getFullYear(), thisMonth.getMonth(), 1);
                  selKey = null;
                  pickOpen = false;
                  build();
                });
              }
              // 选择器年步进（§4.47）：边界按钮已置灰，无需额外钳制
              self.querySelectorAll('.cal-py').forEach(function (btn) {
                btn.addEventListener('click', function () {
                  pickYear += parseInt(btn.dataset.dir, 10);
                  build();
                });
              });
              // 选择器月份点击（§4.47）：跳月并收起选择器
              self.querySelectorAll('.cal-pm:not([disabled])').forEach(function (btn) {
                btn.addEventListener('click', function () {
                  cur = new Date(pickYear, parseInt(btn.dataset.m, 10), 1);
                  selKey = null;
                  pickOpen = false;
                  build();
                });
              });
              // 点热力图格子（§4.43 整列点击，§4.44 还原原版改格子级点击）：跳转对应月份，列表跟随；
              // 未来月份格子无 role 不绑（月视图不允许翻到未来）；Enter/Space 同点按
              self.querySelectorAll('.cal-heat-cell[role="button"]').forEach(function (el) {
                var jump = function () {
                  cur = new Date(+el.dataset.y, +el.dataset.m, 1);
                  selKey = null;
                  build();
                };
                el.addEventListener('click', jump);
                el.addEventListener('keydown', function (e) {
                  if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    jump();
                  }
                });
              });
              // 点日期（§4.40）：toggle 选中，列表在当日/当月间切换；Enter/Space 同点按
              self.querySelectorAll('.cal-day.has-post').forEach(function (el) {
                var toggle = function () {
                  selKey = selKey === el.dataset.key ? null : el.dataset.key;
                  build();
                };
                el.addEventListener('click', toggle);
                el.addEventListener('keydown', function (e) {
                  if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    toggle();
                  }
                });
              });
            };
            build();
          });
        }
      },
    );
  }
</script>
