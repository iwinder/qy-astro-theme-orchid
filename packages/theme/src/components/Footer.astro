---
import config from "virtual:theme/config";

const { title, author, footerText, since, footer } = config;
const now = new Date().getFullYear();
const startYear = since ? parseInt(since.slice(0, 4), 10) : NaN;
const yearLabel =
	!Number.isNaN(startYear) && startYear < now
		? `${startYear}-${now}`
		: String(now);
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <div class="footer-line">© {yearLabel} {author || title}{footerText ? ` · ${footerText}` : ''}</div>
    <div class="footer-sub">
      Powered by Astro · Theme Orchid ·
      <a href="/rss.xml">RSS</a> / <a href="/sitemap.xml">Sitemap</a>
    </div>
    {/* 页脚自定义 HTML（§4.16）：备案号等站点自有内容，作者自担内容安全 */}
    {footer.customHtml && <div class="footer-custom" set:html={footer.customHtml} />}
  </div>
</footer>
