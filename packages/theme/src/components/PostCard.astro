---
import config from "virtual:theme/config";
import { t } from "../i18n/index.js";
import { resolveSiteImage } from "../utils/image.js";
import { getLqipStyle } from "../utils/lqip.js";
import { getThumbInfo } from "../utils/thumb.js";
import { formatDate, type PostLike, resolveCover } from "../utils.js";

interface Props {
	post: PostLike;
	/** 置顶/特写形态（大图卡 + 置顶徽标） */
	featured?: boolean;
}

const { post, featured = false } = Astro.props;
const d = post.data;

/* 形态判定：frontmatter.cardStyle 按篇覆盖 > 全局 postList.style；无图可降级为纯文字 */
const style = d.cardStyle ?? config.postList.style;
/* 封面（§4.33）：image:"api" 时经图源解析出确定性随机图，并携带客户端重试列表；
   §4.55 showCover=false 时整体关闭列表封面（classes/模板自动降级纯文字形态） */
const { cover: rawCover, retries } = resolveCover(
	d.image,
	d.firstImage,
	config.postList.fallbackCover,
	config.postList.randomCover.apis,
	post.id,
);
/* §4.110：封面三格式统一语义（对齐 §4.108 其余消费点）——相对路径（站点 src/
   下）构建期解析为产物 URL，public / 外链原样直通 */
const resolvedCover = rawCover ? await resolveSiteImage(rawCover) : rawCover;
const cover = config.postList.showCover ? resolvedCover : null;
/* §4.106：列表封面用缩略图（外链/未命中自动回退原图；点击进文章页看正文原图） */
const thumb = cover ? getThumbInfo(cover) : null;
const classes = [
	"post-card",
	featured ? "featured" : "",
	cover ? "has-cover" : "no-cover",
	style === "cover" ? "" : "compact",
	style !== "cover" && !cover ? "text-only" : "",
]
	.filter(Boolean)
	.join(" ");

const href = `/posts/${post.id}/`;
const excerpt = d.excerpt || d.description;
---

<article class={classes}>
  {
    cover && (
      <a class="post-cover" href={href} aria-label={d.title}>
        {featured && d.pinned && <span class="pin-badge">{t('pinned')}</span>}
        {/* LQIP 占位渐变（b9.5）：绝对定位盖在 img 上，加载完成后由 app.ts 淡出 */}
        <div class="qy-lqip" style={getLqipStyle(cover)} aria-hidden="true"></div>
        <img
          src={thumb ? thumb.src : cover}
          alt={d.title}
          loading="lazy"
          data-lqip
          data-api-retries={retries ? JSON.stringify(retries) : undefined}
        />
      </a>
    )
  }
  <div class="post-body">
    <h2 class="post-title"><a href={href}>{d.title}</a></h2>
    {excerpt && <p class="post-excerpt">{excerpt}</p>}
    <div class="post-meta">
      <span>{formatDate(d.published)}</span>
      {d.category && <span class="dot">{d.category}</span>}
      {d.password && <span class="dot enc-flag">{t('postEncrypted')}</span>}
      {d.words ? <span class="dot">{t('wordsCount', { n: d.words })}</span> : null}
      {d.minutes ? <span class="dot">{t('minutesCount', { n: d.minutes })}</span> : null}
    </div>
    {
      d.tags.length > 0 && (
        <div class="post-tags">
          {d.tags.map((tag) => (
            <a class="chip" href={`/tags/${encodeURIComponent(tag)}/`}>
              {tag}
            </a>
          ))}
        </div>
      )
    }
  </div>
  {
    /* 无封面卡（§4.34 迭代）：右侧进入按钮竖条，为正文右侧留白，避免文字铺满/挤压 */
    !cover && (
      <a class="post-enter" href={href} aria-label={d.title}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    )
  }
</article>
