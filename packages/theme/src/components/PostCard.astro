---
import config from 'virtual:theme/config';
import { formatDate, type PostLike } from '../utils.js';

interface Props {
  post: PostLike;
  /** 置顶/特写形态（大图卡 + 置顶徽标） */
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const d = post.data;

/* 形态判定：frontmatter.cardStyle 按篇覆盖 > 全局 postList.style；无图可降级为纯文字 */
const style = d.cardStyle ?? config.postList.style;
const cover = d.image || d.firstImage || config.postList.fallbackCover;
const classes = [
  'post-card',
  featured ? 'featured' : '',
  style === 'cover' ? '' : 'compact',
  style !== 'cover' && !cover ? 'text-only' : '',
]
  .filter(Boolean)
  .join(' ');

const href = `/posts/${post.id}/`;
const excerpt = d.excerpt || d.description;
---

<article class={classes}>
  {
    cover && (
      <a class="post-cover" href={href} aria-label={d.title}>
        {featured && d.pinned && <span class="pin-badge">置顶</span>}
        <img src={cover} alt={d.title} loading="lazy" />
      </a>
    )
  }
  <div class="post-body">
    <h2 class="post-title"><a href={href}>{d.title}</a></h2>
    {excerpt && <p class="post-excerpt">{excerpt}</p>}
    <div class="post-meta">
      <span>{formatDate(d.published)}</span>
      {d.category && <span class="dot">{d.category}</span>}
      {d.words ? <span class="dot">{d.words} 字</span> : null}
      {d.minutes ? <span class="dot">约 {d.minutes} 分钟</span> : null}
    </div>
    {
      d.tags.length > 0 && (
        <div class="post-tags">
          {d.tags.map((tag) => (
            <a class="chip" href={`/tags/${encodeURIComponent(tag)}/`}>
              {tag}
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>
