---
import config from 'virtual:theme/config';

interface Props {
  /** 文章级覆盖；空则跟随全站配置 */
  licenseName?: string;
  licenseUrl?: string;
}

const { licenseName, licenseUrl } = Astro.props;
const enabled = config.license.enabled;
const name = licenseName ?? config.license.name;
const url = licenseUrl ?? config.license.url;
---

{
  enabled && (
    <div class="license">
      本文采用 <a href={url} target="_blank" rel="noopener">{name}</a>{' '}
      许可，转载请注明出处与作者。
    </div>
  )
}
