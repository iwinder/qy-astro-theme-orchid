---
import BaseLayout from 'virtual:theme/components/BaseLayout.astro';
---

<BaseLayout title="页面不存在">
  <header class="archive-head reveal" style="text-align: center; max-width: none;">
    <h1 class="page-title">404</h1>
    <p class="page-sub">页面不存在，或已被移动到别处。</p>
    <p style="margin-top: 28px;">
      <a class="btn" href="/">返回首页</a>
    </p>
  </header>
</BaseLayout>
