---
import { getCollection } from "astro:content";
import BaseLayout from "virtual:theme/components/BaseLayout.astro";
import Pagination from "virtual:theme/components/Pagination.astro";
import PostCard from "virtual:theme/components/PostCard.astro";
import Sidebar from "virtual:theme/components/Sidebar.astro";
import config from "virtual:theme/config";
import { t } from "../../../i18n/index.js";
import { collectTags, getSortedPosts } from "../../../utils.js";
import { hydratePosts } from "../../_hydrate.js";

/**
 * 标签详情（§4.87 分页）：每标签按 postList.pageSize 分页，第一页
 * /tags/<tag>/（page 段省略），后续 /tags/<tag>/page/N/。结构与分类详情页一致。
 * 分页段 page/N/ 与布局同构改造见分类详情页注释（§4.113）。
 */
export async function getStaticPaths({ paginate }: { paginate: any }) {
	const all = await getCollection("posts", ({ data }) =>
		import.meta.env.PROD ? !data.draft : true,
	);
	// 先排序再聚合，保证每个标签内文章按新→旧排列
	const sorted = getSortedPosts(all);
	return [...collectTags(sorted).entries()].flatMap(([tag, posts]) =>
		paginate(posts, {
			params: { tag },
			props: { tag, sorted },
			pageSize: config.postList.pageSize,
		}).map((entry: any, i: number) => ({
			params: { tag, page: i > 0 ? `page/${i + 1}` : undefined },
			props: entry.props,
		})),
	);
}

const { page, tag, sorted } = Astro.props;
const pagePosts = await hydratePosts(page.data);
---

<BaseLayout title={t('tagTitle', { tag })} page="tags">
  <div class="home-layout">
    {/* 文章列表：与首页同一容器约定，供 app.ts 恢复与切换网格/列表形态 */}
    <div
      class="post-list"
      id="postList"
      data-allow-switch={config.postList.allowSwitch ? "true" : undefined}
      data-default-layout={config.postList.defaultLayout}
      data-grid-col={config.postList.gridColumnWidth}
    >
      <header class="archive-head reveal">
        <h1 class="page-title">{tag}</h1>
        <p class="page-sub">{t('totalPosts', { n: page.total })}</p>
      </header>
      {
        pagePosts.map((post: any) => (
          <PostCard post={post} featured={post.data.pinned} />
        ))
      }
      <Pagination page={page.currentPage} total={page.lastPage} basePath={`/tags/${tag}/`} />
    </div>
    <Sidebar posts={sorted} />
  </div>
</BaseLayout>
