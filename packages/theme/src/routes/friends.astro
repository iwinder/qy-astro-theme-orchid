---
import { getEntry, render } from "astro:content";
import BaseLayout from "virtual:theme/components/BaseLayout.astro";
import config from "virtual:theme/config";
import { t } from "../i18n/index.js";

// 数据源 = themeConfig.friends.list（决策 8：与侧栏友链 widget 同源）
const friends = config.friends.list
	.filter((f) => f.enabled)
	.sort((a, b) =>
		config.friends.sort === "random"
			? Math.random() - 0.5
			: b.weight - a.weight,
	);

// 可选 spec 正文（src/content/spec/friends.md），渲染在卡片列表上方
const entry = await getEntry("spec", "friends").catch(() => null);
const { Content } = entry ? await render(entry) : { Content: null };

const apply = config.friends.apply;
---

<BaseLayout title={config.friends.title} page="friends">
  <header class="archive-head reveal">
    <h1 class="page-title">{config.friends.title}</h1>
    {config.friends.description && <p class="page-sub">{config.friends.description}</p>}
  </header>

  {
    Content && (
      <article class="card page-card prose reveal" data-lightbox-gallery>
        <Content />
      </article>
    )
  }

  {
    friends.length > 0 ? (
      <div class="friend-grid reveal">
        {friends.map((f) => (
          <a class="friend-card card" href={f.site} target="_blank" rel="noopener">
            <div class="friend-avatar">
              {f.image ? (
                <img src={f.image} alt={t('avatarAlt', { name: f.title })} loading="lazy" />
              ) : (
                <span class="avatar-fallback">{f.title.slice(0, 1)}</span>
              )}
            </div>
            <div class="friend-info">
              <div class="friend-name">{f.title}</div>
              {f.desc && <div class="friend-desc">{f.desc}</div>}
              {f.tags.length > 0 && (
                <div class="friend-tags">
                  {f.tags.map((ft) => (
                    <span class="chip">{ft}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="tag-empty reveal">{t('noFriends')}</p>
    )
  }

  {
    apply.title && (
      <section class="friend-apply card reveal">
        <div>
          <div class="fa-title">{apply.title}</div>
          {apply.description && <p class="fa-desc">{apply.description}</p>}
        </div>
        {apply.link && (
          <a class="btn" href={apply.link}>
            {apply.label || t('applyFriend')}
          </a>
        )}
      </section>
    )
  }
</BaseLayout>
