---
import { getCollection, render } from "astro:content";
// KaTeX 样式：文章页独占加载（构建期渲染无客户端 JS，仅此一份 CSS）
import "katex/dist/katex.min.css";
import BaseLayout from "virtual:theme/components/BaseLayout.astro";
import Comment from "virtual:theme/components/Comment.astro";
import EncryptedContent from "virtual:theme/components/EncryptedContent.astro";
import License from "virtual:theme/components/License.astro";
import OutdatedCard from "virtual:theme/components/OutdatedCard.astro";
import PostNav from "virtual:theme/components/PostNav.astro";
import RecommendedPost from "virtual:theme/components/RecommendedPost.astro";
import Sidebar from "virtual:theme/components/Sidebar.astro";
import Toc from "virtual:theme/components/Toc.astro";
import config from "virtual:theme/config";
import { t } from "../../i18n/index.js";
import { getLqipStyle } from "../../utils/lqip.js";
import { getRelatedPosts } from "../../utils/related.js";
import { formatDate, getSortedPosts } from "../../utils.js";

export async function getStaticPaths() {
	const all = await getCollection("posts", ({ data }) =>
		import.meta.env.PROD ? !data.draft : true,
	);
	const sorted = getSortedPosts(all);
	// sorted 内 idx+1 为更早一篇（prev），idx-1 为更新一篇（next）
	return sorted.map((post, idx) => ({
		params: { slug: post.id },
		props: {
			post,
			prev: sorted[idx + 1] ?? null,
			next: sorted[idx - 1] ?? null,
			related: getRelatedPosts(sorted, post, config.relatedPosts.count),
			// 文章页侧栏（P2）的聚合数据源
			posts: sorted,
		},
	}));
}

const { post, prev, next, related, posts } = Astro.props;
const d = post.data;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const { words, minutes } = remarkPluginFrontmatter as {
	words?: number;
	minutes?: number;
};

const url = new URL(`/posts/${post.id}/`, Astro.site);
// 支持卡（P2）：打赏入口 + 分享海报，二者均关闭则整卡不渲染；加密文章不渲染
const showShareBtn = config.sharePoster.enabled && !d.password;
const showSponsorBtn =
	config.sponsor.showButtonInPost && config.pages.sponsor && !d.password;
// 文章页侧栏（P2）：onPost 开启且非加密文章；侧栏内 toc widget 承担目录
const postSidebar = config.sidebar.onPost && !d.password;
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: d.title,
	description: d.description,
	datePublished: d.published.toISOString(),
	dateModified: (d.updated ?? d.published).toISOString(),
	wordCount: words,
	keywords: d.tags.join(", "),
	author: { "@type": "Person", name: d.author || config.author },
	mainEntityOfPage: url.href,
};
---

<BaseLayout title={d.title} description={d.description} page="post" ogImage={config.og.enabled ? `/og/${post.id}.png` : undefined}>
  {/* 左右两栏布局（对齐参考模板）：标题/封面/正文/许可/上下篇/支持卡/推荐/评论全部收进正文列，
      侧栏（或 TOC）独占右列；≤767px 退化为单列堆叠 */}
  <div class="post-layout">
    <div class="post-main">
  <header class="post-header reveal">
    {d.category && <a class="chip" href={`/categories/${encodeURIComponent(d.category)}/`}>{d.category}</a>}
    <h1 class="post-title-lg" data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title">{d.title}</h1>
    <div class="post-meta">
      <span>{t('publishedOn', { date: formatDate(d.published) })}</span>
      {d.updated && <span class="dot">{t('updatedOn', { date: formatDate(d.updated) })}</span>}
      {words ? <span class="dot">{t('wordsCount', { n: words })}</span> : null}
      {minutes ? <span class="dot">{t('minutesCount', { n: minutes })}</span> : null}
      {d.pinned && <span class="dot pin-flag">{t('pinned')}</span>}
      {d.password && <span class="dot enc-flag">{t('postEncrypted')}</span>}
    </div>
  </header>
  {
    d.image && (
      <figure class="article-cover reveal" data-lightbox>
        <div class="qy-lqip" style={getLqipStyle(d.image)} aria-hidden="true"></div>
        <img src={d.image} alt={d.title} loading="eager" data-lqip />
      </figure>
    )
  }
    {/* data-pagefind-body（M3b-b6）：限定 Pagefind 只索引标题与正文（h1 在 article 外，双 body 标记） */}
    <article class="prose reveal" data-pagefind-body>
      {d.password ? (
        /* 加密文章（M3b-b7）：构建期把正文渲染后整体加密，页面只出密文 + 锁 UI；
           TOC 的 headings 来自构建期明文解析，会在锁旁泄漏标题结构，故一并隐藏 */
        <EncryptedContent password={d.password} slug={post.id} hint={d.passwordHint}>
          <Content />
        </EncryptedContent>
      ) : (
        <Content />
      )}
    </article>
    {/* 过时提醒（§4.11）：许可卡之前展示；加密文章不渲染 */}
    {!d.password && <OutdatedCard updated={d.updated ?? d.published} published={d.published} />}
    <License licenseName={d.licenseName} licenseUrl={d.licenseUrl} enabled={d.license} />
    <PostNav prev={prev ?? undefined} next={next ?? undefined} />
  {/* 支持卡（P2）：打赏入口 + 分享海报（share-poster.ts 仍按 #qy-share-btn 与 data-* 绑定） */}
  {
    (showSponsorBtn || showShareBtn) && (
      <div class="support-card reveal">
        <div class="support-info">
          <h3>{t('supportTitle')}</h3>
          <p>{t('supportDesc')}</p>
        </div>
        <div class="support-actions">
          {showSponsorBtn && (
            <a class="btn-sponsor" href="/sponsor/">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
              {t('sponsorMe')}
            </a>
          )}
          {showShareBtn && (
            <button
              type="button"
              id="qy-share-btn"
              class="btn-poster"
              data-title={d.title}
              data-author={d.author || config.author || config.title}
              data-desc={d.description}
              data-date={d.published.toISOString()}
              data-cover={d.image ?? ''}
              data-url={url.href}
              data-site={config.title}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
              {t('sharePoster')}
            </button>
          )}
        </div>
      </div>
    )
  }
  {/* 相关/随机文章推荐（P1-12）：相关栏构建期评分，随机栏客户端抽取；候选均已排除加密文章 */}
  {
    config.relatedPosts.enabled && (
      <RecommendedPost related={related} currentId={post.id} randomCount={config.relatedPosts.randomCount} />
    )
  }
  {/* 加密文章不渲染评论（评论内容依赖正文上下文，明文评论区会破坏加密语义） */}
  <Comment path={`/posts/${post.id}`} enabled={d.comment && !d.password} title={d.title} />
    </div>
    {/* 侧栏开关（P2）：onPost 时侧栏进右列，TOC 由侧栏 toc widget 承担；
        关闭侧栏时 TOC 保持正文右侧原位 */}
    {postSidebar ? (
      <Sidebar posts={posts} variant="post" headings={headings} currentId={post.id} />
    ) : (
      config.toc.enabled && !d.password && <Toc headings={headings} />
    )}
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
