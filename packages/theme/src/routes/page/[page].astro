---
import { getCollection } from "astro:content";
import BaseLayout from "virtual:theme/components/BaseLayout.astro";
import Pagination from "virtual:theme/components/Pagination.astro";
import PostCard from "virtual:theme/components/PostCard.astro";
import Sidebar from "virtual:theme/components/Sidebar.astro";
import config from "virtual:theme/config";
import { t } from "../../i18n/index.js";
import { getSortedPosts } from "../../utils.js";
import { hydratePosts } from "../_hydrate.js";

export async function getStaticPaths() {
	const all = await getCollection("posts", ({ data }) =>
		import.meta.env.PROD ? !data.draft : true,
	);
	const rest = getSortedPosts(all).filter((p) => !p.data.pinned);
	const total = Math.max(1, Math.ceil(rest.length / config.postList.pageSize));
	// 第 1 页由 / 承担，这里生成 /page/2/ 起的分页
	return Array.from({ length: total - 1 }, (_, i) => ({
		params: { page: String(i + 2) },
		props: { page: i + 2, total, posts: rest },
	}));
}

const { page, total, posts } = Astro.props;
const pagePosts = await hydratePosts(
	posts.slice(
		(page - 1) * config.postList.pageSize,
		page * config.postList.pageSize,
	),
);
---

<BaseLayout title={t('pageN', { n: page })} page="home">
  {
    config.hero.quote && (
      <section class="hero reveal">
        <h1 class="hero-quote" set:html={config.hero.quote} />
        {config.hero.sub && <p class="hero-sub">{config.hero.sub}</p>}
      </section>
    )
  }
  <div class="home-layout">
    {/* 文章列表（§4.34）：与首页同一容器约定，供 app.ts 恢复与切换网格/列表形态 */}
    <div
      class="post-list"
      id="postList"
      data-allow-switch={config.postList.allowSwitch ? "true" : undefined}
      data-grid-col={config.postList.gridColumnWidth}
    >
      <div class="list-head">
        <h2 class="section-title reveal">{t('recentPosts')}</h2>
        {
          config.postList.allowSwitch && (
            <button
              class="layout-switch"
              id="layoutSwitch"
              type="button"
              aria-label={t('layoutSwitch')}
              aria-pressed="false"
              title={t('layoutSwitch')}
            >
              <svg class="ic-list" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
              <svg class="ic-grid" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            </button>
          )
        }
      </div>
      {pagePosts.map((post) => <PostCard post={post} />)}
      <Pagination page={page} total={total} basePath="/" />
    </div>
    <Sidebar posts={posts} />
  </div>
</BaseLayout>
