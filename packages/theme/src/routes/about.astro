---
import { getEntry, render } from "astro:content";
import BaseLayout from "virtual:theme/components/BaseLayout.astro";
import { t } from "../i18n/index.js";

// 正文来自站点 spec 集合（src/content/spec/about.md）；
// 集合或条目缺失时降级为提示文案，不使整页 500
const entry = await getEntry("spec", "about").catch(() => null);
const { Content } = entry ? await render(entry) : { Content: null };
---

<BaseLayout title={t('about')} page="about">
  <header class="archive-head reveal">
    <h1 class="page-title">{t('about')}</h1>
  </header>
  <article class="card page-card prose reveal" data-lightbox-gallery>
    {
      Content ? (
        <Content />
      ) : (
        <p class="tag-empty">{t('aboutEmpty')}</p>
      )
    }
  </article>
</BaseLayout>
