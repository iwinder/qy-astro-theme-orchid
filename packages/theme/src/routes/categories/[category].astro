---
import { getCollection } from 'astro:content';
import BaseLayout from 'virtual:theme/components/BaseLayout.astro';
import { collectCategories, formatDate, getSortedPosts } from '../../utils.js';
import { t } from '../../i18n/index.js';

// 先排序再聚合，保证每个分类内文章按新→旧排列
export async function getStaticPaths() {
  const all = await getCollection('posts', ({ data }) => (import.meta.env.PROD ? !data.draft : true));
  const sorted = getSortedPosts(all);
  return [...collectCategories(sorted).entries()].map(([category, posts]) => ({
    params: { category },
    props: { category, posts },
  }));
}

const { category, posts } = Astro.props;
---

<BaseLayout title={t('categoryTitle', { category })} page="categories">
  <header class="archive-head reveal">
    <h1 class="page-title">{category}</h1>
    <p class="page-sub">{t('totalPosts', { n: posts.length })}</p>
  </header>
  <div class="tag-list">
    {
      posts.map((post) => (
        <a class="related-card card tag-item reveal" href={`/posts/${post.id}/`}>
          <div class="rc-title">{post.data.title}</div>
          <div class="rc-meta">{formatDate(post.data.published)}</div>
        </a>
      ))
    }
  </div>
</BaseLayout>
