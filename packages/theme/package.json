{
	"name": "@windcoder/astro-theme-orchid",
	"version": "0.2.1",
	"description": "清新简约的 Astro 博客主题，以 Integration 形式提供，支持版本化升级与组件覆盖",
	"type": "module",
	"keywords": [
		"astro",
		"astro-integration",
		"blog",
		"theme",
		"tailwindcss"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iwinder/qy-astro-theme-orchid.git",
		"directory": "packages/theme"
	},
	"homepage": "https://github.com/iwinder/qy-astro-theme-orchid/tree/main/packages/theme#readme",
	"bugs": "https://github.com/iwinder/qy-astro-theme-orchid/issues",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema.ts",
		"./routes/*": "./src/routes/*",
		"./components/*": "./src/components/*",
		"./plugins/*": "./src/plugins/*",
		"./styles/*": "./src/styles/*"
	},
	"files": [
		"src",
		"scripts",
		"!scripts/*.test.mjs"
	],
	"peerDependencies": {
		"@iconify-json/lucide": "^1.2.0",
		"@iconify-json/simple-icons": "^1.2.0",
		"astro": "^7.0.0"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.2",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"@expressive-code/plugin-collapsible-sections": "^0.44.2",
		"@expressive-code/plugin-line-numbers": "^0.44.2",
		"@tailwindcss/vite": "^4.3.2",
		"astro-icon": "^1.2.0",
		"beautiful-mermaid": "^1.1.3",
		"expressive-code-collapsible": "^0.1.0",
		"expressive-code-language-badge": "^1.1.0",
		"hastscript": "^9.0.1",
		"katex": "^0.19.0",
		"l2d-widget": "^0.1.2",
		"pako": "^3.0.2",
		"photoswipe": "^5.4.4",
		"qrcode": "^1.5.4",
		"rehype-expressive-code": "^0.44.2",
		"rehype-katex": "^7.0.1",
		"remark-directive": "^4.0.0",
		"remark-math": "^6.0.0",
		"satori": "^0.47.1",
		"sharp": "^0.35.5",
		"subset-font": "^2.5.0",
		"tailwindcss": "^4.3.2",
		"web-vitals": "^6.2.3"
	},
	"devDependencies": {
		"@types/pako": "^2.0.3",
		"@types/qrcode": "^1.5.6"
	}
}
